---
// TechStack component - Simplified "built with" section for transparency
---

<section id="tech-stack" class="relative bg-[#f8fafc] py-16 border-t border-slate-200">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3.5 py-1 text-xs font-semibold text-slate-600 uppercase tracking-wider mb-3.5 shadow-xs">
        Built With
      </div>
      <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">
        Reliable technology for school use.
      </h2>
      <p class="mt-2.5 text-base text-slate-600 leading-relaxed">
        TIS RMS is built with modern, proven tools chosen for long-term stability and ease of maintenance.
      </p>
    </div>

    <!-- Tech tags -->
    <div class="mt-10 flex flex-wrap justify-center gap-2.5">
      {[
        "Flutter (Windows Desktop & Android)",
        "Node.js Backend",
        "SQLite Database",
        "Tesseract OCR Pipeline",
        "DepEd SF-10 Excel Generator",
        "Campus LAN Architecture",
        "Role-Based Access Control",
        "Windows NSIS Installer",
      ].map((tech) => (
        <span class="rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 shadow-xs transition hover:border-slate-300">
          {tech}
        </span>
      ))}
    </div>

  </div>
</section>
