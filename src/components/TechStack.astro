---
// TechStack component - Simplified "built with" section for transparency
---

<section id="tech-stack" class="relative bg-[#09110c] py-20 border-t border-white/5 text-white">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-slate-400 uppercase tracking-widest mb-3">Built With</p>
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">
        Reliable technology for school use.
      </h2>
      <p class="mt-3 text-base text-slate-400 leading-relaxed">
        TIS RMS is built with modern, proven tools chosen for long-term stability and ease of maintenance.
      </p>
    </div>

    <!-- Simple tech tags — readable, not detailed -->
    <div class="mt-12 flex flex-wrap justify-center gap-3">
      {[
        "Flutter (Windows & Android)",
        "Node.js Server",
        "SQLite Database",
        "Tesseract OCR",
        "ExcelJS",
        "Campus LAN Architecture",
        "Role-Based Access",
        "Windows Installer",
      ].map((tech) => (
        <span class="rounded-full border border-white/10 bg-white/4 px-4 py-2 text-sm text-slate-300">
          {tech}
        </span>
      ))}
    </div>

  </div>
</section>
