---
// AppShowcase component - Actual app screenshots
const showcaseTabs = [
  {
    id: "dashboard",
    title: "Dashboard",
    tagline: "A quick overview of all archived student records and statistics.",
    image: "/screenshots/dashboard.webp",
  },
  {
    id: "students",
    title: "Student Directory",
    tagline: "Search any student by name or LRN and view their basic profile.",
    image: "/screenshots/students.webp",
  },
  {
    id: "documents",
    title: "Document Vault",
    tagline: "Browse and preview all archived student folders and documents.",
    image: "/screenshots/documents.webp",
  },
  {
    id: "reports",
    title: "Records Summary",
    tagline: "View totals and statistics for archived records and 4Ps classifications.",
    image: "/screenshots/reports.webp",
  },
];
---

<section id="showcase" class="relative bg-[#09110c] py-24 text-white border-t border-white/5">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-[#4ade80] uppercase tracking-widest mb-3">App Preview</p>
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
        See the app in action.
      </h2>
      <p class="mt-4 text-base text-slate-400 leading-relaxed">
        Real screenshots from the desktop app built specifically for Talisay Integrated School.
      </p>
    </div>

    <!-- Tab Buttons -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
      {showcaseTabs.map((tab, idx) => (
        <button
          type="button"
          data-tab={tab.id}
          class={`tab-btn rounded-lg px-4 py-2 text-sm font-medium transition-all border ${
            idx === 0
              ? "bg-[#16a34a] text-white border-[#16a34a]"
              : "bg-transparent text-slate-400 border-white/10 hover:text-white hover:border-white/20"
          }`}
        >
          {tab.title}
        </button>
      ))}
    </div>

    <!-- Screenshot Window -->
    <div class="mt-8 overflow-hidden rounded-2xl border border-white/10 bg-[#0c1610] shadow-2xl shadow-black/60">

      <!-- Simple window titlebar -->
      <div class="flex items-center gap-2.5 border-b border-white/5 bg-[#15803d] px-4 py-2.5">
        <img src="/tis_logo.png" alt="TIS" class="h-4 w-4 object-contain" />
        <span class="text-sm font-semibold text-white">TIS Record Management System</span>
      </div>

      <!-- Screenshot Area -->
      <div class="relative bg-[#09110c] p-3 sm:p-4">
        {showcaseTabs.map((tab, idx) => (
          <div
            id={`tab-content-${tab.id}`}
            class={`tab-content ${idx === 0 ? "block" : "hidden"}`}
          >
            <div class="overflow-hidden rounded-xl border border-white/8">
              <img
                src={tab.image}
                alt={`TIS RMS ${tab.title}`}
                loading="lazy"
                class="w-full object-cover aspect-[16/10]"
              />
            </div>
            <!-- Caption -->
            <div class="mt-4 text-center">
              <h3 class="font-display text-lg font-semibold text-white">{tab.title}</h3>
              <p class="text-sm text-slate-400 mt-1">{tab.tagline}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const contents = document.querySelectorAll<HTMLElement>('.tab-content');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;

      buttons.forEach((b) => {
        b.classList.remove('bg-[#16a34a]', 'text-white', 'border-[#16a34a]');
        b.classList.add('bg-transparent', 'text-slate-400', 'border-white/10');
      });

      btn.classList.remove('bg-transparent', 'text-slate-400', 'border-white/10');
      btn.classList.add('bg-[#16a34a]', 'text-white', 'border-[#16a34a]');

      contents.forEach((content) => {
        if (content.id === `tab-content-${target}`) {
          content.classList.remove('hidden');
          content.classList.add('block');
        } else {
          content.classList.add('hidden');
          content.classList.remove('block');
        }
      });
    });
  });
</script>
