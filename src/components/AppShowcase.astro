---
// AppShowcase component - Actual app screenshots
const showcaseTabs = [
  {
    id: "dashboard",
    title: "Dashboard",
    tagline: "A quick overview of all archived student records and statistics.",
    image: "/screenshots/dashboard.webp",
  },
  {
    id: "students",
    title: "Student Directory",
    tagline: "Search any student by name or LRN and view their basic profile.",
    image: "/screenshots/students.webp",
  },
  {
    id: "documents",
    title: "Document Vault",
    tagline: "Browse and preview all archived student folders and documents.",
    image: "/screenshots/documents.webp",
  },
  {
    id: "reports",
    title: "Records Summary",
    tagline: "View totals and statistics for archived records and 4Ps classifications.",
    image: "/screenshots/reports.webp",
  },
];
---

<section id="showcase" class="relative bg-white py-20 border-t border-slate-200">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-[#ecfdf5] px-3.5 py-1 text-xs font-semibold text-[#15803d] uppercase tracking-wider mb-3.5">
        App Preview
      </div>
      <h2 class="font-display text-3xl font-bold text-slate-900 sm:text-4xl">
        See the app in action.
      </h2>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Real screenshots from the desktop app built specifically for Talisay Integrated School.
      </p>
    </div>

    <!-- Tab Buttons -->
    <div class="mt-9 flex flex-wrap items-center justify-center gap-2">
      {showcaseTabs.map((tab, idx) => (
        <button
          type="button"
          data-tab={tab.id}
          class={`tab-btn rounded-xl px-4 py-2 text-sm font-semibold transition-all border shadow-xs ${
            idx === 0
              ? "bg-[#15803d] text-white border-[#15803d] shadow-sm"
              : "bg-white text-slate-600 border-slate-200 hover:text-slate-900 hover:border-slate-300"
          }`}
        >
          {tab.title}
        </button>
      ))}
    </div>

    <!-- Screenshot Window (Authentic Desktop Client Window Styling) -->
    <div class="mt-8 overflow-hidden rounded-2xl border border-slate-300/80 bg-white shadow-xl">

      <!-- Desktop Client Titlebar matching app screenshot -->
      <div class="flex items-center justify-between border-b border-emerald-800/40 bg-[#15803d] px-4 py-2.5 select-none">
        <div class="flex items-center gap-2.5">
          <img src="/tis_logo.png" alt="TIS Logo" class="h-4.5 w-4.5 object-contain" width="18" height="18" />
          <span class="text-xs sm:text-sm font-medium text-white tracking-wide">TIS Record Management System</span>
        </div>
        <!-- Window minimize / maximize / close icons matching desktop app -->
        <div class="flex items-center gap-4 text-white/80 text-xs">
          <span class="hover:text-white cursor-default transition">─</span>
          <span class="hover:text-white cursor-default transition">□</span>
          <span class="hover:text-white cursor-default transition">✕</span>
        </div>
      </div>

      <!-- Screenshot Area -->
      <div class="relative bg-slate-100/70 p-2 sm:p-4">
        {showcaseTabs.map((tab, idx) => (
          <div
            id={`tab-content-${tab.id}`}
            class={`tab-content ${idx === 0 ? "block" : "hidden"}`}
          >
            <div class="overflow-hidden rounded-xl border border-slate-200 shadow-xs bg-white">
              <img
                src={tab.image}
                alt={`TIS RMS ${tab.title}`}
                loading="lazy"
                class="w-full object-cover aspect-[16/9.5]"
              />
            </div>
            <!-- Caption -->
            <div class="mt-4 text-center pb-2">
              <h3 class="font-display text-lg font-bold text-slate-900">{tab.title}</h3>
              <p class="text-sm text-slate-600 mt-0.5">{tab.tagline}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const contents = document.querySelectorAll<HTMLElement>('.tab-content');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;

      buttons.forEach((b) => {
        b.classList.remove('bg-[#15803d]', 'text-white', 'border-[#15803d]', 'shadow-sm');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
      });

      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
      btn.classList.add('bg-[#15803d]', 'text-white', 'border-[#15803d]', 'shadow-sm');

      contents.forEach((content) => {
        if (content.id === `tab-content-${target}`) {
          content.classList.remove('hidden');
          content.classList.add('block');
        } else {
          content.classList.add('hidden');
          content.classList.remove('block');
        }
      });
    });
  });
</script>
