---
// AppShowcase component - Official Windows and Android app screenshots
const modules = [
  {
    id: "dashboard",
    title: "Dashboard",
    tagline: "Overview of student records, active staff, digitalization progress, and KPI metrics.",
    windowsImg: "/screenshots/windows/dashboard.webp",
    androidImg: "/screenshots/android/dashboard.webp",
  },
  {
    id: "students",
    title: "Students",
    tagline: "Quick learner lookup by LRN or name with grade classification and folder status.",
    windowsImg: "/screenshots/windows/students.webp",
    androidImg: "/screenshots/android/students.webp",
  },
  {
    id: "documents",
    title: "Documents",
    tagline: "Browse and inspect digitized student document folders and scanned paperwork.",
    windowsImg: "/screenshots/windows/documents.webp",
    androidImg: "/screenshots/android/documents.webp",
  },
  {
    id: "archives",
    title: "Archives",
    tagline: "Long-term historical archive repository for legacy school years (2021 onwards).",
    windowsImg: "/screenshots/windows/archives.webp",
    androidImg: "/screenshots/android/archives.webp",
  },
  {
    id: "reports",
    title: "Reports",
    tagline: "Generate summary breakdowns, 4Ps distributions, and official SF-10 report outputs.",
    windowsImg: "/screenshots/windows/reports.webp",
    androidImg: "/screenshots/android/reports.webp",
  },
  {
    id: "users",
    title: "Users",
    tagline: "Manage school faculty and registrar accounts with role-based access privileges.",
    windowsImg: "/screenshots/windows/users.webp",
    androidImg: "/screenshots/android/users.webp",
  },
  {
    id: "history",
    title: "History",
    tagline: "Full audit logs tracking document uploads, edits, registrations, and logins.",
    windowsImg: "/screenshots/windows/history.webp",
    androidImg: "/screenshots/android/history.webp",
  },
  {
    id: "settings",
    title: "Settings",
    tagline: "Configure LAN server connectivity, automated database backups, and school profiles.",
    windowsImg: "/screenshots/windows/settings.webp",
    androidImg: "/screenshots/android/settings.webp",
  },
];
---

<section id="showcase" class="relative bg-white py-20 border-t border-slate-200">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-[#ecfdf5] px-3.5 py-1 text-xs font-semibold text-[#15803d] uppercase tracking-wider mb-3.5">
        Screenshots
      </div>
      <h2 class="font-display text-3xl font-bold text-slate-900 sm:text-4xl">
        See the app in action.
      </h2>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Real screenshots from the Windows client and Android mobile app built for Talisay Integrated School.
      </p>
    </div>

    <!-- Platform Selector (Windows vs Android) -->
    <div class="mt-8 flex items-center justify-center">
      <div class="inline-flex items-center rounded-2xl border border-slate-200 bg-slate-100/80 p-1.5 shadow-inner">
        <button
          type="button"
          data-platform="windows"
          class="platform-btn flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold transition-all bg-[#15803d] text-white shadow-sm"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801"/>
          </svg>
          Windows App
        </button>
        <button
          type="button"
          data-platform="android"
          class="platform-btn flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold transition-all text-slate-600 hover:text-slate-900"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4111 13.8533 8.0805 12 8.0805s-3.5902.3306-5.1367.8692L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/>
          </svg>
          Android App
        </button>
      </div>
    </div>

    <!-- Module Tabs -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
      {modules.map((m, idx) => (
        <button
          type="button"
          data-module={m.id}
          class={`module-btn rounded-xl px-3.5 py-1.5 text-xs sm:text-sm font-semibold transition-all border shadow-xs ${
            idx === 0
              ? "bg-[#15803d] text-white border-[#15803d] shadow-sm"
              : "bg-white text-slate-600 border-slate-200 hover:text-slate-900 hover:border-slate-300"
          }`}
        >
          {m.title}
        </button>
      ))}
    </div>

    <!-- Screenshots Display Container -->
    <div id="showcase-container" class="mt-8 mx-auto max-w-5xl transition-all duration-300">

      <!-- Windows Screenshots -->
      {modules.map((m, idx) => (
        <div
          data-platform="windows"
          data-module={m.id}
          class={`showcase-item ${idx === 0 ? "block" : "hidden"}`}
        >
          <div class="overflow-hidden rounded-2xl border border-slate-200/90 shadow-2xl bg-white">
            <img
              src={m.windowsImg}
              alt={`TIS RMS Windows - ${m.title}`}
              loading="lazy"
              class="w-full h-auto block"
            />
          </div>
          <!-- Caption -->
          <div class="mt-4 text-center">
            <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#15803d] mb-1">
              <span>Windows Desktop Client</span>
              <span>•</span>
              <span>{m.title}</span>
            </div>
            <p class="text-sm text-slate-600">{m.tagline}</p>
          </div>
        </div>
      ))}

      <!-- Android Screenshots -->
      {modules.map((m) => (
        <div
          data-platform="android"
          data-module={m.id}
          class="showcase-item hidden"
        >
          <div class="overflow-hidden rounded-2xl border border-slate-200/90 shadow-2xl bg-white">
            <img
              src={m.androidImg}
              alt={`TIS RMS Android - ${m.title}`}
              loading="lazy"
              class="w-full h-auto block"
            />
          </div>
          <!-- Caption -->
          <div class="mt-4 text-center">
            <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#15803d] mb-1">
              <span>Android Mobile App</span>
              <span>•</span>
              <span>{m.title}</span>
            </div>
            <p class="text-sm text-slate-600">{m.tagline}</p>
          </div>
        </div>
      ))}

    </div>

  </div>
</section>

<script>
  const platformBtns = document.querySelectorAll<HTMLButtonElement>('.platform-btn');
  const moduleBtns = document.querySelectorAll<HTMLButtonElement>('.module-btn');
  const showcaseItems = document.querySelectorAll<HTMLElement>('.showcase-item');
  const showcaseContainer = document.getElementById('showcase-container');

  let activePlatform = 'windows';
  let activeModule = 'dashboard';

  function updateView() {
    // Update platform button states
    platformBtns.forEach((btn) => {
      const isSelected = btn.dataset.platform === activePlatform;
      if (isSelected) {
        btn.classList.add('bg-[#15803d]', 'text-white', 'shadow-sm');
        btn.classList.remove('text-slate-600', 'hover:text-slate-900');
      } else {
        btn.classList.remove('bg-[#15803d]', 'text-white', 'shadow-sm');
        btn.classList.add('text-slate-600', 'hover:text-slate-900');
      }
    });

    // Update module button states
    moduleBtns.forEach((btn) => {
      const isSelected = btn.dataset.module === activeModule;
      if (isSelected) {
        btn.classList.add('bg-[#15803d]', 'text-white', 'border-[#15803d]', 'shadow-sm');
        btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');
      } else {
        btn.classList.remove('bg-[#15803d]', 'text-white', 'border-[#15803d]', 'shadow-sm');
        btn.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
      }
    });

    // Adjust container width for desktop landscape vs mobile portrait
    if (showcaseContainer) {
      if (activePlatform === 'windows') {
        showcaseContainer.className = 'mt-8 mx-auto max-w-5xl transition-all duration-300';
      } else {
        showcaseContainer.className = 'mt-8 mx-auto max-w-xs sm:max-w-sm transition-all duration-300';
      }
    }

    // Toggle display of corresponding screenshot
    showcaseItems.forEach((item) => {
      const p = item.dataset.platform;
      const m = item.dataset.module;
      if (p === activePlatform && m === activeModule) {
        item.classList.remove('hidden');
        item.classList.add('block');
      } else {
        item.classList.add('hidden');
        item.classList.remove('block');
      }
    });
  }

  platformBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activePlatform = btn.dataset.platform || 'windows';
      updateView();
    });
  });

  moduleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeModule = btn.dataset.module || 'dashboard';
      updateView();
    });
  });
</script>
