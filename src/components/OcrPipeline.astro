---
// OcrPipeline component
const pipelineSteps = [
  {
    step: "01",
    title: "Document Ingestion & Capture",
    description: "Scan paper documents via Android MLKit Scanner or drag-and-drop PDFs/Images directly into the desktop client.",
    tag: "Input Layer",
    tech: "MLKit / Desktop Upload",
    icon: "M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12",
  },
  {
    step: "02",
    title: "Ghostscript Rasterization",
    description: "Multi-page PDFs are rasterized into high-resolution image matrices to maximize character recognition precision.",
    tag: "Preprocessing",
    tech: "Ghostscript Engine",
    icon: "M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    step: "03",
    title: "Tesseract OCR Extraction",
    description: "Locally bundled Tesseract OCR analyzes character glyphs, line coordinates, and key educational fields.",
    tag: "OCR Processing",
    tech: "Tesseract Engine",
    icon: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
  {
    step: "04",
    title: "Normalization & SQLite Record",
    description: "Extracted strings (LRN, Student Name, Birth Date, Grades) are parsed and committed into the `better-sqlite3` database.",
    tag: "Structured Data",
    tech: "SQLite & Parser",
    icon: "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4",
  },
  {
    step: "05",
    title: "School Form 10 Export",
    description: "Structured student records populate DepEd School Form 10 (SF-10 JHS/SHS) templates with zero manual typing.",
    tag: "Report Output",
    tech: "ExcelJS Engine",
    icon: "M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
];
---

<section id="ocr-pipeline" class="relative bg-[#09110c] py-24 border-t border-[#1f3627] text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#2a4c37] bg-[#112017] px-4 py-1 text-xs font-semibold text-[#4ade80]">
        <img src="/tis_logo.png" alt="TIS Logo" class="h-3.5 w-3.5 object-contain" />
        <span>Automated Data Extraction</span>
      </div>
      <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        How the OCR Document Pipeline Works
      </h2>
      <p class="mt-4 text-base text-slate-300 sm:text-lg">
        Transform physical transcript scans, report cards, and enrollment forms into indexed, structured digital database records.
      </p>
    </div>

    <!-- Pipeline Step Grid -->
    <div class="mt-16 grid gap-6 md:grid-cols-3 lg:grid-cols-5">
      {pipelineSteps.map((step) => (
        <div class="group relative flex flex-col justify-between rounded-2xl border border-[#233e2e] bg-[#112017]/90 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-[#16a34a] hover:bg-[#15271d] hover:shadow-xl">
          
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-2xl font-black text-[#16a34a]/40 group-hover:text-[#4ade80]">
                {step.step}
              </span>
              <span class="rounded-md bg-black/30 border border-[#233e2e] px-2 py-0.5 text-[10px] font-bold text-amber-400">
                {step.tag}
              </span>
            </div>

            <div class="mt-4 flex h-10 w-10 items-center justify-center rounded-xl bg-[#16a34a]/15 text-[#4ade80] transition-colors group-hover:bg-[#16a34a] group-hover:text-white">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={step.icon} />
              </svg>
            </div>

            <h3 class="mt-4 font-display text-base font-bold text-white group-hover:text-[#a7f3d0] transition-colors">
              {step.title}
            </h3>

            <p class="mt-2 text-xs leading-relaxed text-slate-300">
              {step.description}
            </p>
          </div>

          <div class="mt-6 border-t border-[#1f3627] pt-3">
            <div class="flex items-center gap-1.5 text-[11px] font-mono text-emerald-400">
              <span class="h-1.5 w-1.5 rounded-full bg-[#16a34a]"></span>
              {step.tech}
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- OCR Demo Simulation Banner -->
    <div class="mt-12 overflow-hidden rounded-2xl border border-[#23412f] bg-[#0c1610] p-6 sm:p-8 text-white shadow-2xl">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-md bg-amber-500/20 px-2.5 py-1 text-xs font-mono font-semibold text-amber-300 border border-amber-500/30">
            <span>⚡ Automated Extraction Benchmark</span>
          </div>
          <h3 class="mt-3 font-display text-2xl font-bold text-white">
            Convert 100+ scanned student transcripts in minutes.
          </h3>
          <p class="mt-2 text-sm text-slate-300">
            Eliminate manual entry bottlenecks during enrollment and graduation seasons. TIS RMS processes multi-page PDFs using local Ghostscript and Tesseract OCR thread pools directly on your local campus server in Talisay.
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="#downloads"
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-[#16a34a] to-[#15803d] px-5 py-3 text-xs font-semibold text-white shadow-lg shadow-[#16a34a]/30 hover:from-[#15803d] hover:to-[#0f5c2b]"
          >
            <span>Try OCR Ingestion</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
