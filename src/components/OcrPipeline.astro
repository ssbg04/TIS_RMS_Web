---
// OcrPipeline component
const pipelineSteps = [
  {
    step: "01",
    title: "Document Ingestion",
    description: "Scan historical physical documents (2021 onwards) via Android scanner or drag-and-drop PDFs into the desktop client.",
    tag: "Input Layer",
    tech: "MLKit / Desktop Ingest",
  },
  {
    step: "02",
    title: "Ghostscript Rasterization",
    description: "Multi-page historical PDFs are rasterized into high-resolution image matrices to maximize recognition precision.",
    tag: "Preprocessing",
    tech: "Ghostscript Engine",
  },
  {
    step: "03",
    title: "Tesseract OCR Extraction",
    description: "Locally bundled Tesseract OCR extracts text lines, identifying key learner biodata and archival fields.",
    tag: "OCR Processing",
    tech: "Tesseract Engine",
  },
  {
    step: "04",
    title: "Basic Info Normalization",
    description: "Extracted basic fields (LRN, Full Name, Birth Date, Gender, Origin) are parsed and committed into the SQLite database.",
    tag: "Structured Data",
    tech: "SQLite & Parser",
  },
  {
    step: "05",
    title: "SF-10 & SF-9 Integration",
    description: "Structured learner records populate DepEd SF-10 templates for basic student registration with zero manual typing.",
    tag: "Report Output",
    tech: "ExcelJS Engine",
  },
];
---

<section id="ocr-pipeline" class="relative bg-[#09110c] py-24 border-t border-[#1f3627] text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#2a4c37] bg-[#112017] px-4 py-1 text-xs font-semibold text-[#4ade80]">
        <img src="/tis_logo.png" alt="TIS Logo" class="h-3.5 w-3.5 object-contain" />
        <span>Document Digitization</span>
      </div>
      <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        How the OCR Document Pipeline Works
      </h2>
      <p class="mt-4 text-base text-slate-300 sm:text-lg">
        Transform physical documents and scanned records from 2021 onwards into indexed, structured digital profiles.
      </p>
    </div>

    <!-- Pipeline Step Grid - Minimalist Design Without Icon Redundancy -->
    <div class="mt-16 grid gap-6 md:grid-cols-3 lg:grid-cols-5">
      {pipelineSteps.map((step) => (
        <div class="group relative flex flex-col justify-between rounded-2xl border border-[#233e2e] bg-[#112017]/90 p-6 transition hover:border-[#16a34a] hover:bg-[#15271d]">
          
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-xl font-bold text-[#4ade80]">
                {step.step}
              </span>
              <span class="rounded bg-black/30 border border-[#233e2e] px-2 py-0.5 text-[10px] font-mono text-amber-400">
                {step.tag}
              </span>
            </div>

            <h3 class="mt-4 font-display text-sm font-bold text-white group-hover:text-[#a7f3d0] transition-colors">
              {step.title}
            </h3>

            <p class="mt-2 text-xs leading-relaxed text-slate-300">
              {step.description}
            </p>
          </div>

          <div class="mt-6 border-t border-[#1f3627] pt-3">
            <div class="text-[11px] font-mono text-emerald-400">
              {step.tech}
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- OCR Archival Benchmark Banner -->
    <div class="mt-12 overflow-hidden rounded-2xl border border-[#23412f] bg-[#0c1610] p-6 sm:p-8 text-white shadow-xl">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-md bg-amber-500/15 px-2.5 py-1 text-xs font-mono font-semibold text-amber-300 border border-amber-500/30">
            <span>Automated Archival Benchmark</span>
          </div>
          <h3 class="mt-3 font-display text-2xl font-bold text-white">
            Digitize 100+ historical student files in minutes.
          </h3>
          <p class="mt-2 text-sm text-slate-300">
            Eliminate manual transcription bottlenecks when organizing student files from 2021 onwards. TIS RMS processes multi-page PDFs using local Ghostscript and Tesseract OCR thread pools directly on your local campus server.
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="#downloads"
            class="inline-flex items-center rounded-xl bg-[#16a34a] px-5 py-3 text-xs font-semibold text-white shadow-md shadow-[#16a34a]/20 hover:bg-[#15803d]"
          >
            Get OCR Scanner App
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
