---
// Downloads component - Official installers for Talisay Integrated School
---

<section id="downloads" class="relative bg-[#09110c] py-24 text-white overflow-hidden border-t border-[#1f3627]">
  <!-- Glow Accents -->
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute left-1/3 top-0 h-[600px] w-[600px] rounded-full bg-[#16a34a]/15 blur-[140px]"></div>
    <div class="absolute right-10 bottom-0 h-[450px] w-[450px] rounded-full bg-[#f59e0b]/10 blur-[120px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#2a4c37] bg-[#112017] px-4 py-1 text-xs font-semibold text-[#4ade80]">
        <img src="/tis_logo.png" alt="TIS Logo" class="h-3.5 w-3.5 object-contain" />
        <span>Official Distribution</span>
      </div>
      <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        Download TIS RMS Releases
      </h2>
      <p class="mt-4 text-base text-slate-300 sm:text-lg">
        Deploy the Windows desktop client for teacher PCs, install the Android APK for mobile scanning, or set up the campus server daemon.
      </p>
    </div>

    <!-- Release Artifacts Cards Grid -->
    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      
      <!-- Card 1: Windows Client -->
      <div class="group relative flex flex-col justify-between rounded-2xl border border-[#23412f] bg-[#112017]/90 p-6 transition hover:border-[#16a34a] hover:bg-[#15271d]">
        <div>
          <div class="flex items-center justify-between">
            <span class="font-display font-bold text-sm text-blue-400">Windows Desktop</span>
            <span class="rounded bg-[#16a34a]/15 px-2.5 py-0.5 text-[10px] font-mono font-semibold text-[#4ade80] border border-[#16a34a]/30">
              v1.0.0 (Latest)
            </span>
          </div>

          <h3 class="mt-4 font-display text-lg font-bold text-white">Windows Desktop Setup</h3>
          <p class="mt-1 text-xs text-emerald-400 font-mono">TIS_RMS_Client_Setup.exe</p>
          
          <p class="mt-3 text-xs text-slate-300 leading-relaxed">
            Full Windows installation package created with Inno Setup. Includes desktop shortcuts and direct campus LAN database connectivity.
          </p>

          <div class="mt-5 space-y-1.5 text-xs text-slate-400 font-mono">
            <div>— Windows 10 / 11 (64-bit)</div>
            <div>— Teacher Workstations & Registrars</div>
          </div>
        </div>

        <div class="mt-6">
          <a
            href="https://github.com/ssbg04/TIS_RMS/releases/latest"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center rounded-xl bg-[#16a34a] py-3 text-xs font-semibold text-white transition hover:bg-[#15803d]"
          >
            Download Setup (.exe)
          </a>
        </div>
      </div>

      <!-- Card 2: Android Universal APK -->
      <div class="group relative flex flex-col justify-between rounded-2xl border border-[#23412f] bg-[#112017]/90 p-6 transition hover:border-[#16a34a] hover:bg-[#15271d]">
        <div>
          <div class="flex items-center justify-between">
            <span class="font-display font-bold text-sm text-[#4ade80]">Android Mobile</span>
            <span class="rounded bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-mono font-semibold text-[#4ade80] border border-emerald-500/20">
              Universal Build
            </span>
          </div>

          <h3 class="mt-4 font-display text-lg font-bold text-white">Android Mobile Client</h3>
          <p class="mt-1 text-xs text-emerald-400 font-mono">TIS_RMS_Android_Universal.apk</p>
          
          <p class="mt-3 text-xs text-slate-300 leading-relaxed">
            Universal Android APK for educators. Features MLKit camera document scanning, offline cache, and instant document upload to the local school database.
          </p>

          <div class="mt-5 space-y-1.5 text-xs text-slate-400 font-mono">
            <div>— Android 8.0+ (ARM64 & x86_64)</div>
            <div>— MLKit Camera Scanner</div>
          </div>
        </div>

        <div class="mt-6">
          <a
            href="https://github.com/ssbg04/TIS_RMS/releases/download/v1.0.0/TIS_RMS_Android_Universal.apk"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center rounded-xl bg-[#16271c] py-3 text-xs font-semibold text-white transition hover:bg-[#1d3525] border border-[#23412f]"
          >
            Download APK (.apk)
          </a>
        </div>
      </div>

      <!-- Card 3: Backend Windows Service Setup -->
      <div class="group relative flex flex-col justify-between rounded-2xl border border-[#23412f] bg-[#112017]/90 p-6 transition hover:border-[#16a34a] hover:bg-[#15271d] md:col-span-2 lg:col-span-1">
        <div>
          <div class="flex items-center justify-between">
            <span class="font-display font-bold text-sm text-amber-400">Campus Server</span>
            <span class="rounded bg-amber-500/15 px-2.5 py-0.5 text-[10px] font-mono font-semibold text-amber-300 border border-amber-500/30">
              Campus Server
            </span>
          </div>

          <h3 class="mt-4 font-display text-lg font-bold text-white">Backend School Server</h3>
          <p class="mt-1 text-xs text-amber-400 font-mono">Node.js Express Campus Daemon</p>
          
          <p class="mt-3 text-xs text-slate-300 leading-relaxed">
            Run the Node backend continuously on your school server PC via NSSM background service — accessible across faculty Wi-Fi.
          </p>

          <div class="mt-4 rounded-xl border border-[#1f3627] bg-[#09110c] p-3 font-mono text-[11px] text-[#4ade80] space-y-1">
            <div>npm run service:install</div>
            <div>npm run service:start</div>
            <div class="text-slate-500">npm run service:status</div>
          </div>
        </div>

        <div class="mt-6">
          <a
            href="https://github.com/ssbg04/TIS_RMS"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center rounded-xl bg-[#16271c] py-3 text-xs font-semibold text-white transition hover:bg-[#1d3525] border border-[#23412f]"
          >
            View Source on GitHub
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
