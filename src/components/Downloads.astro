---
const currentYear = new Date().getFullYear();
const releasesUrl = "https://github.com/ssbg04/TIS_RMS/releases/latest";

// Default known latest release (v2.0.62) baked into SSR so buttons work instantly
const latestTag = "v2.0.62";
const latestDate = "October 30, 2026";
const defaultDownloads = {
  windows: {
    name: "TIS_RMS_Client_Setup_v2.0.62.exe",
    url: "https://github.com/ssbg04/TIS_RMS/releases/download/v2.0.62/TIS_RMS_Client_Setup_v2.0.62.exe",
    size: " · 38.4 MB"
  },
  universal: {
    name: "TIS_RMS_Universal_v2.0.62.apk",
    url: "https://github.com/ssbg04/TIS_RMS/releases/download/v2.0.62/TIS_RMS_Universal_v2.0.62.apk",
    size: " · 66.9 MB"
  },
  arm64: {
    name: "TIS_RMS_64_v2.0.62.apk",
    url: "https://github.com/ssbg04/TIS_RMS/releases/download/v2.0.62/TIS_RMS_64_v2.0.62.apk",
    size: " · 25.8 MB"
  },
  armeabi: {
    name: "TIS_RMS_32bit_v2.0.62.apk",
    url: "https://github.com/ssbg04/TIS_RMS/releases/download/v2.0.62/TIS_RMS_32bit_v2.0.62.apk",
    size: " · 23.6 MB"
  }
};

const androidIcon = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M6.18 9.6a.72.72 0 1 0 0 1.44.72.72 0 0 0 0-1.44Zm11.64 0a.72.72 0 1 0 0 1.44.72.72 0 0 0 0-1.44ZM15.66 3.3l1.2-2.08a.3.3 0 0 0-.52-.3l-1.22 2.12A7.44 7.44 0 0 0 12 2.4a7.44 7.44 0 0 0-3.12.64L7.66.92a.3.3 0 0 0-.52.3l1.2 2.08A6.72 6.72 0 0 0 5.28 8.4h13.44A6.72 6.72 0 0 0 15.66 3.3ZM5.28 9.6v7.08a1.44 1.44 0 0 0 1.44 1.44h.72V21a1.2 1.2 0 0 0 2.4 0v-2.88h4.32V21a1.2 1.2 0 0 0 2.4 0v-2.88h.72a1.44 1.44 0 0 0 1.44-1.44V9.6H5.28ZM3 9.6a1.2 1.2 0 0 0-1.2 1.2v4.8a1.2 1.2 0 0 0 2.4 0V10.8A1.2 1.2 0 0 0 3 9.6Zm18 0a1.2 1.2 0 0 0-1.2 1.2v4.8a1.2 1.2 0 0 0 2.4 0V10.8A1.2 1.2 0 0 0 21 9.6Z"/></svg>`;

const windowsIcon = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M2 4.2 10.8 3v8.1H2V4.2Zm10-1.35L22 1.5v9.6H12v-8.25ZM2 12.8h8.8v8.1L2 19.65v-6.85Zm10 0h10v9.7l-10-1.4v-8.3Z"/></svg>`;
---

<section id="downloads" class="downloads-section" aria-label="Downloads section">
  <div class="downloads-container">
    <div class="section-heading reveal-init">
      <div class="eyebrow-badge">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>Start here</span>
      </div>
      <h2>Get TIS RMS</h2>
      <p>Free for Talisay Integrated School staff. Direct downloads from official GitHub Releases.</p>
      <div class="release-meta-pill">
        <span id="release-version">{latestTag}</span>
        <span id="release-date">{latestDate}</span>
      </div>
    </div>

    <p id="release-error" class="release-error" hidden>
      Notice: Could not refresh latest metadata from GitHub. Showing verified stable downloads.
      <a href={releasesUrl} target="_blank" rel="noopener noreferrer">Browse GitHub Releases</a>.
    </p>

    <!-- Platform Cards Grid -->
    <div class="platform-grid">
      <!-- Windows Card -->
      <div class="platform-card reveal-init delay-1">
        <div class="platform-card-header">
          <div class="platform-brand">
            <div class="platform-card-icon windows-icon" set:html={windowsIcon} />
            <div class="platform-card-title">
              <h3>Windows Desktop</h3>
              <span>Server host &amp; workstation client</span>
            </div>
          </div>
          <span class="platform-card-badge">Win 10 / 11</span>
        </div>

        <div id="windows-list" class="download-list" aria-live="polite">
          <a
            class="download-option"
            id="dl-opt-windows"
            href={defaultDownloads.windows.url}
            download={defaultDownloads.windows.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="download-platform">
              <span class="platform-icon windows-icon" set:html={windowsIcon} />
              <span>
                <strong>Windows Setup</strong>
                <small id="dl-win-desc">Windows 10 and 11 · Desktop app<span id="dl-win-size">{defaultDownloads.windows.size}</span></small>
              </span>
            </span>
            <span class="download-action">Download <span aria-hidden="true">↓</span></span>
          </a>
        </div>
      </div>

      <!-- Android Card -->
      <div class="platform-card reveal-init delay-2">
        <div class="platform-card-header">
          <div class="platform-brand">
            <div class="platform-card-icon android-icon" set:html={androidIcon} />
            <div class="platform-card-title">
              <h3>Android Mobile</h3>
              <span>Handheld client for faculty &amp; staff</span>
            </div>
          </div>
          <span class="platform-card-badge">Android 5.0+</span>
        </div>

        <div id="android-list" class="download-list" aria-live="polite">
          <!-- Universal (Recommended) -->
          <a
            class="download-option"
            id="dl-opt-universal"
            href={defaultDownloads.universal.url}
            download={defaultDownloads.universal.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="download-platform">
              <span class="platform-icon android-icon" set:html={androidIcon} />
              <span>
                <strong>Android universal<span class="download-badge">Recommended</span></strong>
                <small id="dl-uni-desc">Compatible with 32-bit and 64-bit devices<span id="dl-uni-size">{defaultDownloads.universal.size}</span></small>
              </span>
            </span>
            <span class="download-action">Download <span aria-hidden="true">↓</span></span>
          </a>

          <div class="abi-divider" role="separator"><span>Split APKs by ABI</span></div>

          <!-- 64-bit -->
          <a
            class="download-option download-option-abi"
            id="dl-opt-arm64"
            href={defaultDownloads.arm64.url}
            download={defaultDownloads.arm64.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="download-platform">
              <span class="platform-icon android-icon" set:html={androidIcon} />
              <span>
                <strong>Android 64-bit</strong>
                <small id="dl-arm64-desc">arm64-v8a · Most modern devices<span id="dl-arm64-size">{defaultDownloads.arm64.size}</span></small>
              </span>
            </span>
            <span class="download-action">Download <span aria-hidden="true">↓</span></span>
          </a>

          <!-- 32-bit -->
          <a
            class="download-option download-option-abi"
            id="dl-opt-armeabi"
            href={defaultDownloads.armeabi.url}
            download={defaultDownloads.armeabi.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="download-platform">
              <span class="platform-icon android-icon" set:html={androidIcon} />
              <span>
                <strong>Android 32-bit</strong>
                <small id="dl-armeabi-desc">armeabi-v7a · Older compatible devices<span id="dl-armeabi-size">{defaultDownloads.armeabi.size}</span></small>
              </span>
            </span>
            <span class="download-action">Download <span aria-hidden="true">↓</span></span>
          </a>
        </div>

        <!-- ABI Picker Helper Accordion -->
        <details class="abi-helper">
          <summary>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
              <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
            <span>Which Android download should I choose?</span>
            <span class="abi-chevron" aria-hidden="true">↓</span>
          </summary>
          <div class="abi-helper-body">
            <p><strong>Android universal (Recommended):</strong> Works on virtually any Android smartphone or tablet. If you aren't sure of your device's processor, pick this one.</p>
            <p><strong>Split APKs (arm64-v8a / armeabi-v7a):</strong> Smaller file sizes tailored for specific chipsets. <em>64-bit</em> is best for modern phones; <em>32-bit</em> is for older or entry-level phones.</p>
          </div>
        </details>
      </div>
    </div>

    <!-- Footnote -->
    <div class="download-footnote reveal-init delay-3">
      <span>Looking for older releases or release notes?</span>
      <a href={releasesUrl} target="_blank" rel="noopener noreferrer">View all releases on GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <!-- Redesigned Comprehensive Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-main">
        <div class="footer-brand-col">
          <a class="brand" href="/" aria-label="TIS RMS Home">
            <img src="/tis_logo.webp" alt="TIS Logo" width="34" height="34" />
            <span class="brand-text">
              <strong class="brand-title">TIS RMS</strong>
              <small class="brand-subtitle">Talisay Integrated School</small>
            </span>
          </a>
          <p class="footer-desc">
            A secure, private records management system designed specifically for Talisay Integrated School faculty, registrars, and administrators.
          </p>
        </div>

        <div class="footer-links-grid">
          <div class="footer-links-col">
            <h4>Navigation</h4>
            <ul>
              <li><a href="https://demo.tisrms.de5.net" target="_blank" rel="noopener noreferrer">Live Demo ↗</a></li>
              <li><a href="https://docs.tisrms.de5.net" target="_blank" rel="noopener noreferrer">Documentation ↗</a></li>
              <li><a href="#downloads">Downloads</a></li>
            </ul>
          </div>

          <div class="footer-links-col">
            <h4>Resources</h4>
            <ul>
              <li><a href="https://github.com/ssbg04/TIS_RMS" target="_blank" rel="noopener noreferrer">GitHub Repository ↗</a></li>
              <li><a href="https://github.com/ssbg04/TIS_RMS/releases" target="_blank" rel="noopener noreferrer">All Releases ↗</a></li>
              <li><a href="https://github.com/ssbg04/TIS_RMS/issues" target="_blank" rel="noopener noreferrer">Report an Issue ↗</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <span>© {currentYear} Talisay Integrated School · Tiaong, Quezon, Philippines</span>
        <span>Local School Network System · DepEd Records</span>
      </div>
    </div>
  </footer>

  <script define:vars={{ releasesUrl, androidIcon, windowsIcon }}>
    const CACHE_KEY = "tis-rms-release-cache";
    const releaseApiUrl = "https://api.github.com/repos/ssbg04/TIS_RMS/releases/latest";

    function formatSize(bytes) {
      return bytes ? ` · ${(bytes / (1024 * 1024)).toFixed(1)} MB` : "";
    }

    function updateDownloadLinks(release) {
      const assets = release.assets || [];
      const windowsAsset = assets.find((a) => /\.exe$/i.test(a.name));
      const universalAsset = assets.find((a) => /universal.*\.apk$/i.test(a.name));
      const arm64Asset = assets.find((a) => /(?:64|arm64|arm_64).*\.apk$/i.test(a.name) && !/universal/i.test(a.name));
      const armeabiAsset = assets.find((a) => /(?:32|v7a|armeabi).*\.apk$/i.test(a.name) && !/universal/i.test(a.name));

      // Version & date
      const versionEl = document.getElementById("release-version");
      if (versionEl && release.tag_name) versionEl.textContent = release.tag_name;
      const dateEl = document.getElementById("release-date");
      if (dateEl && release.published_at) {
        dateEl.textContent = new Date(release.published_at).toLocaleDateString(undefined, {
          year: "numeric", month: "long", day: "numeric",
        });
      }

      // Windows Link
      const winEl = document.getElementById("dl-opt-windows");
      if (winEl && windowsAsset?.browser_download_url) {
        winEl.href = windowsAsset.browser_download_url;
        winEl.setAttribute("download", windowsAsset.name);
        const winSizeEl = document.getElementById("dl-win-size");
        if (winSizeEl) winSizeEl.textContent = formatSize(windowsAsset.size);
      }

      // Universal Link
      const uniEl = document.getElementById("dl-opt-universal");
      if (uniEl && universalAsset?.browser_download_url) {
        uniEl.href = universalAsset.browser_download_url;
        uniEl.setAttribute("download", universalAsset.name);
        const uniSizeEl = document.getElementById("dl-uni-size");
        if (uniSizeEl) uniSizeEl.textContent = formatSize(universalAsset.size);
      }

      // 64-bit Link
      const arm64El = document.getElementById("dl-opt-arm64");
      if (arm64El && arm64Asset?.browser_download_url) {
        arm64El.href = arm64Asset.browser_download_url;
        arm64El.setAttribute("download", arm64Asset.name);
        const arm64SizeEl = document.getElementById("dl-arm64-size");
        if (arm64SizeEl) arm64SizeEl.textContent = formatSize(arm64Asset.size);
      }

      // 32-bit Link
      const armeabiEl = document.getElementById("dl-opt-armeabi");
      if (armeabiEl && armeabiAsset?.browser_download_url) {
        armeabiEl.href = armeabiAsset.browser_download_url;
        armeabiEl.setAttribute("download", armeabiAsset.name);
        const armeabiSizeEl = document.getElementById("dl-armeabi-size");
        if (armeabiSizeEl) armeabiSizeEl.textContent = formatSize(armeabiAsset.size);
      }
    }

    async function loadLatestDownloads() {
      try {
        const cached = sessionStorage.getItem(CACHE_KEY);
        if (cached) {
          updateDownloadLinks(JSON.parse(cached));
          return;
        }

        const response = await fetch(releaseApiUrl, {
          headers: { Accept: "application/vnd.github+json" },
        });
        if (!response.ok) return;

        const release = await response.json();
        sessionStorage.setItem(CACHE_KEY, JSON.stringify(release));
        updateDownloadLinks(release);
      } catch {
        // Fallback: SSR links already work!
      }
    }

    loadLatestDownloads();

    // ── Bypass GitHub App on Android ─────────────────────────────────────────
    function triggerAndroidDownload(url) {
      const iframe = document.createElement("iframe");
      iframe.style.position = "fixed";
      iframe.style.top = "0";
      iframe.style.left = "0";
      iframe.style.width = "1px";
      iframe.style.height = "1px";
      iframe.style.opacity = "0.01";
      iframe.style.pointerEvents = "none";
      iframe.style.border = "none";
      iframe.src = url;
      document.body.appendChild(iframe);
      setTimeout(() => {
        try { iframe.remove(); } catch (_) {}
      }, 30000);
    }

    function setupAndroidDownload(id) {
      const el = document.getElementById(id);
      el?.addEventListener("click", (e) => {
        const isAndroid = /android/i.test(navigator.userAgent || "");
        if (isAndroid && el.href) {
          e.preventDefault();
          triggerAndroidDownload(el.href);
        }
      });
    }

    setupAndroidDownload("dl-opt-universal");
    setupAndroidDownload("dl-opt-arm64");
    setupAndroidDownload("dl-opt-armeabi");

    // Scroll reveal observer for downloads section
    const dlElements = document.querySelectorAll(".downloads-section .reveal-init");
    const dlObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            dlObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    dlElements.forEach((el) => dlObserver.observe(el));
  </script>
</section>
