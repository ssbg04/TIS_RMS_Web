---
const currentYear = new Date().getFullYear();
const releasesUrl = "https://github.com/ssbg04/TIS_RMS/releases/latest";

const androidIcon = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M6.18 9.6a.72.72 0 1 0 0 1.44.72.72 0 0 0 0-1.44Zm11.64 0a.72.72 0 1 0 0 1.44.72.72 0 0 0 0-1.44ZM15.66 3.3l1.2-2.08a.3.3 0 0 0-.52-.3l-1.22 2.12A7.44 7.44 0 0 0 12 2.4a7.44 7.44 0 0 0-3.12.64L7.66.92a.3.3 0 0 0-.52.3l1.2 2.08A6.72 6.72 0 0 0 5.28 8.4h13.44A6.72 6.72 0 0 0 15.66 3.3ZM5.28 9.6v7.08a1.44 1.44 0 0 0 1.44 1.44h.72V21a1.2 1.2 0 0 0 2.4 0v-2.88h4.32V21a1.2 1.2 0 0 0 2.4 0v-2.88h.72a1.44 1.44 0 0 0 1.44-1.44V9.6H5.28ZM3 9.6a1.2 1.2 0 0 0-1.2 1.2v4.8a1.2 1.2 0 0 0 2.4 0V10.8A1.2 1.2 0 0 0 3 9.6Zm18 0a1.2 1.2 0 0 0-1.2 1.2v4.8a1.2 1.2 0 0 0 2.4 0V10.8A1.2 1.2 0 0 0 21 9.6Z"/></svg>`;

const windowsIcon = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M2 4.2 10.8 3v8.1H2V4.2Zm10-1.35L22 1.5v9.6H12v-8.25ZM2 12.8h8.8v8.1L2 19.65v-6.85Zm10 0h10v9.7l-10-1.4v-8.3Z"/></svg>`;
---

<section id="downloads" class="downloads-section">
  <div class="section-heading">
    <p class="eyebrow">Start here</p>
    <h2>Get TIS RMS</h2>
    <p>Free for Talisay Integrated School staff. Downloads are kept up to date from GitHub Releases.</p>
    <p class="release-meta"><span id="release-version">Latest release</span><span id="release-date"></span></p>
  </div>
  <p id="release-error" class="release-error" hidden>Some downloads could not be loaded. <a href={releasesUrl} target="_blank" rel="noopener noreferrer">Browse GitHub Releases</a>.</p>

  <!-- Windows -->
  <div class="platform-group">
    <div class="platform-group-label">
      <span class="platform-group-icon windows-icon" set:html={windowsIcon}></span>
      <span>Windows</span>
    </div>
    <div id="windows-list" class="download-list" aria-live="polite" aria-busy="true">
      <!-- Skeleton -->
      <div class="download-option skeleton" aria-hidden="true">
        <span class="download-platform">
          <span class="platform-icon skeleton-box" style="border-radius:8px"></span>
          <span style="display:grid;gap:6px"><span class="skeleton-line" style="width:100px"></span><span class="skeleton-line" style="width:160px"></span></span>
        </span>
      </div>
    </div>
  </div>

  <!-- Android -->
  <div class="platform-group">
    <div class="platform-group-label">
      <span class="platform-group-icon android-icon" set:html={androidIcon}></span>
      <span>Android</span>
    </div>
    <div id="android-list" class="download-list" aria-live="polite" aria-busy="true">
      <!-- Skeletons -->
      {[1,2,3].map(() => (
        <div class="download-option skeleton" aria-hidden="true">
          <span class="download-platform">
            <span class="platform-icon skeleton-box" style="border-radius:8px"></span>
            <span style="display:grid;gap:6px"><span class="skeleton-line" style="width:120px"></span><span class="skeleton-line" style="width:170px"></span></span>
          </span>
        </div>
      ))}
    </div>
  </div>

  <div class="download-footnote">
    <span>Looking for older releases?</span>
    <a href={releasesUrl} target="_blank" rel="noopener noreferrer">View all releases <span aria-hidden="true">↗</span></a>
  </div>

  <script define:vars={{ releasesUrl, androidIcon, windowsIcon }}>
    const CACHE_KEY = "tis-rms-release-cache";
    const releaseApiUrl = "https://api.github.com/repos/ssbg04/TIS_RMS/releases/latest";

    function formatSize(bytes) {
      return bytes ? ` · ${(bytes / (1024 * 1024)).toFixed(1)} MB` : "";
    }

    function buildRow(label, detail, asset, extraClass = "", badge = "") {
      const href = asset?.browser_download_url || releasesUrl;
      const size = formatSize(asset?.size);
      const action = asset ? "Download" : "View releases";
      const arrow = asset ? "↓" : "↗";
      const ext = asset ? "" : ' target="_blank" rel="noopener noreferrer"';
      const badgeHtml = badge ? `<span class="download-badge">${badge}</span>` : "";
      return `<a class="download-option${extraClass}" href="${href}"${ext}>
        <span class="download-platform">
          <span class="platform-icon android-icon">${androidIcon}</span>
          <span>
            <strong>${label}${badgeHtml}</strong>
            <small>${detail}${size}</small>
          </span>
        </span>
        <span class="download-action">${action} <span aria-hidden="true">${arrow}</span></span>
      </a>`;
    }

    function buildWindowsRow(asset) {
      const href = asset?.browser_download_url || releasesUrl;
      const size = formatSize(asset?.size);
      const action = asset ? "Download" : "View releases";
      const arrow = asset ? "↓" : "↗";
      const ext = asset ? "" : ' target="_blank" rel="noopener noreferrer"';
      return `<a class="download-option" href="${href}"${ext}>
        <span class="download-platform">
          <span class="platform-icon windows-icon">${windowsIcon}</span>
          <span>
            <strong>Windows</strong>
            <small>Windows 10 and 11 · Desktop app${size}</small>
          </span>
        </span>
        <span class="download-action">${action} <span aria-hidden="true">${arrow}</span></span>
      </a>`;
    }

    function renderRelease(release) {
      const assets = release.assets || [];
      const windowsAsset = assets.find((a) => /\.exe$/i.test(a.name));
      const universalAsset = assets.find((a) => /universal.*\.apk$/i.test(a.name));
      const arm64Asset = assets.find((a) => /(?:64|arm64|arm_64).*\.apk$/i.test(a.name) && !/universal/i.test(a.name));
      const armeabiAsset = assets.find((a) => /(?:32|v7a|armeabi).*\.apk$/i.test(a.name) && !/universal/i.test(a.name));

      // Version & date
      const version = document.getElementById("release-version");
      if (version && release.tag_name) version.textContent = release.tag_name;
      const date = document.getElementById("release-date");
      if (date && release.published_at) {
        date.textContent = new Date(release.published_at).toLocaleDateString(undefined, {
          year: "numeric", month: "long", day: "numeric",
        });
      }

      // Windows
      const windowsList = document.getElementById("windows-list");
      if (windowsList) {
        windowsList.innerHTML = buildWindowsRow(windowsAsset);
        windowsList.setAttribute("aria-busy", "false");
      }

      // Android: universal (recommended) → divider → splits
      const androidList = document.getElementById("android-list");
      if (androidList) {
        androidList.innerHTML =
          buildRow("Android universal", "Compatible with 32-bit and 64-bit devices", universalAsset, "", "Recommended") +
          `<div class="abi-divider" role="separator"><span>Split APKs by ABI</span></div>` +
          buildRow("Android 64-bit", "arm64-v8a · Most modern devices", arm64Asset, " download-option-abi") +
          buildRow("Android 32-bit", "armeabi-v7a · Older compatible devices", armeabiAsset, " download-option-abi");
        androidList.setAttribute("aria-busy", "false");
      }

      const error = document.getElementById("release-error");
      if (!windowsAsset || !universalAsset || !arm64Asset || !armeabiAsset) {
        if (error) error.hidden = false;
      }
    }

    async function loadLatestDownloads() {
      try {
        // Try session cache first
        const cached = sessionStorage.getItem(CACHE_KEY);
        if (cached) {
          renderRelease(JSON.parse(cached));
          return;
        }

        const response = await fetch(releaseApiUrl, {
          headers: { Accept: "application/vnd.github+json" },
        });
        if (!response.ok) throw new Error(`GitHub returned ${response.status}`);

        const release = await response.json();
        sessionStorage.setItem(CACHE_KEY, JSON.stringify(release));
        renderRelease(release);
      } catch {
        const error = document.getElementById("release-error");
        if (error) error.hidden = false;
        document.getElementById("windows-list")?.setAttribute("aria-busy", "false");
        document.getElementById("android-list")?.setAttribute("aria-busy", "false");
        // Fallback: clear skeletons and show basic links
        const wl = document.getElementById("windows-list");
        if (wl) wl.innerHTML = buildWindowsRow(null);
        const al = document.getElementById("android-list");
        if (al) al.innerHTML =
          buildRow("Android universal", "Compatible with 32-bit and 64-bit devices", null, "", "Recommended") +
          `<div class="abi-divider" role="separator"><span>Split APKs by ABI</span></div>` +
          buildRow("Android 64-bit", "arm64-v8a · Most modern devices", null, " download-option-abi") +
          buildRow("Android 32-bit", "armeabi-v7a · Older compatible devices", null, " download-option-abi");
      }
    }

    loadLatestDownloads();
  </script>

  <footer class="site-footer">
    <a class="brand footer-brand" href="/">
      <img src="/tis_logo.png" alt="" width="30" height="30" />
      <span><strong>TIS RMS</strong><small>Talisay Integrated School</small></span>
    </a>
    <span>© {currentYear} Talisay Integrated School · Tiaong, Quezon</span>
    <a href="https://github.com/ssbg04/TIS_RMS" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
  </footer>
</section>
