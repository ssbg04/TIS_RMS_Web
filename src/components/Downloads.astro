---
const currentYear = new Date().getFullYear();
const releasesUrl = "https://github.com/ssbg04/TIS_RMS/releases/latest";
const androidIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.1 8.1 5.7 5.7a.5.5 0 0 1 .86-.5L8 7.7a9.3 9.3 0 0 1 8 0l1.44-2.5a.5.5 0 0 1 .87.5l-1.4 2.4a8 8 0 0 1 3.7 6.6H3.4a8 8 0 0 1 3.7-6.6ZM7.2 11a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Zm9.6 0a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8ZM3.4 15.1h17.2v3.1a1.8 1.8 0 0 1-1.8 1.8h-.7v2.1a1.2 1.2 0 0 1-2.4 0V20H8.3v2.1a1.2 1.2 0 0 1-2.4 0V20h-.7a1.8 1.8 0 0 1-1.8-1.8v-3.1Z"/></svg>';
const windowsIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 4.2 10.8 3v8.1H2V4.2Zm10-1.35L22 1.5v9.6H12v-8.25ZM2 12.8h8.8v8.1L2 19.65v-6.85Zm10 0h10v9.7l-10-1.4v-8.3Z"/></svg>';
---

<section id="downloads" class="downloads-section">
  <div class="section-heading">
    <p class="eyebrow">Start here</p>
    <h2>Get TIS RMS</h2>
    <p>Free for Talisay Integrated School staff. Downloads are kept up to date from GitHub Releases.</p>
    <p class="release-meta"><span id="release-version">Latest release</span><span id="release-date"></span></p>
  </div>
  <p id="release-error" class="release-error" hidden>Some downloads could not be loaded. <a href={releasesUrl} target="_blank" rel="noopener noreferrer">Browse GitHub Releases</a>.</p>
  <div id="download-list" class="download-list" aria-live="polite" aria-busy="true">
    <a class="download-option" href={releasesUrl}>
      <span class="download-platform"><span class="platform-icon windows-icon" set:html={windowsIcon}></span><span><strong>Windows</strong><small>Windows 10 and 11 · Desktop app</small></span></span>
      <span class="download-action">View releases <span aria-hidden="true">↗</span></span>
    </a>
    <a class="download-option" href={releasesUrl}>
      <span class="download-platform"><span class="platform-icon android-icon" set:html={androidIcon}></span><span><strong>Android universal</strong><small>Compatible with 32-bit and 64-bit devices</small></span></span>
      <span class="download-action">View releases <span aria-hidden="true">↗</span></span>
    </a>
    <a class="download-option" href={releasesUrl}>
      <span class="download-platform"><span class="platform-icon android-icon" set:html={androidIcon}></span><span><strong>Android 64-bit</strong><small>arm64-v8a · Most modern devices</small></span></span>
      <span class="download-action">View releases <span aria-hidden="true">↗</span></span>
    </a>
    <a class="download-option" href={releasesUrl}>
      <span class="download-platform"><span class="platform-icon android-icon" set:html={androidIcon}></span><span><strong>Android 32-bit</strong><small>armeabi-v7a · Compatible devices</small></span></span>
      <span class="download-action">View releases <span aria-hidden="true">↗</span></span>
    </a>
  </div>
  <div class="download-footnote">
    <span>Looking for older releases?</span>
    <a href={releasesUrl} target="_blank" rel="noopener noreferrer">View all releases <span aria-hidden="true">↗</span></a>
  </div>
  <script define:vars={{ releasesUrl, androidIcon, windowsIcon }}>
    const releaseApiUrl = "https://api.github.com/repos/ssbg04/TIS_RMS/releases/latest";

    async function loadLatestDownloads() {
      const list = document.getElementById("download-list");
      const error = document.getElementById("release-error");
      if (!list) return;

      try {
        const response = await fetch(releaseApiUrl, {
          headers: { Accept: "application/vnd.github+json" },
        });
        if (!response.ok) throw new Error(`GitHub returned ${response.status}`);

        const release = await response.json();
        const assets = release.assets || [];
        const windowsAsset = assets.find((asset) => /\.exe$/i.test(asset.name));
        const androidPackages = [
          {
            label: "Android universal",
            detail: "Compatible with 32-bit and 64-bit devices",
            asset: assets.find((asset) => /universal.*\.apk$/i.test(asset.name)),
          },
          {
            label: "Android 64-bit",
            detail: "arm64-v8a · Most modern devices",
            asset: assets.find((asset) => /(?:64|arm64|arm_64).*\.apk$/i.test(asset.name) && !/universal/i.test(asset.name)),
          },
          {
            label: "Android 32-bit",
            detail: "armeabi-v7a · Compatible devices",
            asset: assets.find((asset) => /(?:32|v7a|armeabi).*\.apk$/i.test(asset.name) && !/universal/i.test(asset.name)),
          },
        ];

        const version = document.getElementById("release-version");
        if (version && release.tag_name) version.textContent = release.tag_name;
        const date = document.getElementById("release-date");
        if (date && release.published_at) {
          date.textContent = new Date(release.published_at).toLocaleDateString(undefined, {
            year: "numeric",
            month: "long",
            day: "numeric",
          });
        }

        const options = [
          { label: "Windows", asset: windowsAsset, detail: "Windows 10 and 11 · Desktop app", icon: windowsIcon, iconClass: " windows-icon" },
          ...androidPackages.map((item) => ({ ...item, icon: androidIcon, iconClass: " android-icon" })),
        ];
        list.innerHTML = options.map(({ label, asset, detail, icon, iconClass }) => {
          const href = asset?.browser_download_url || releasesUrl;
          const action = asset ? "Download" : "View releases";
          const size = asset?.size ? ` · ${(asset.size / (1024 * 1024)).toFixed(1)} MB` : "";
          return `<a class="download-option" href="${href}"${asset ? "" : ' target="_blank" rel="noopener noreferrer"'}>
            <span class="download-platform"><span class="platform-icon${iconClass}">${icon}</span><span><strong>${label}</strong><small>${detail}${size}</small></span></span>
            <span class="download-action">${action} <span aria-hidden="true">${asset ? "↓" : "↗"}</span></span>
          </a>`;
        }).join("");

        if (!windowsAsset || androidPackages.some((item) => !item.asset)) {
          if (error) error.hidden = false;
        }
      } catch {
        if (error) error.hidden = false;
        list.querySelectorAll(".download-option").forEach((link) => {
          link.href = releasesUrl;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        });
      } finally {
        list.setAttribute("aria-busy", "false");
      }
    }

    loadLatestDownloads();
  </script>
  <footer class="site-footer">
    <a class="brand footer-brand" href="/">
      <img src="/tis_logo.png" alt="" width="30" height="30" />
      <span><strong>TIS RMS</strong><small>Talisay Integrated School</small></span>
    </a>
    <span>© {currentYear} Talisay Integrated School · Tiaong, Quezon</span>
    <a href="https://github.com/ssbg04/TIS_RMS" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
  </footer>
</section>
