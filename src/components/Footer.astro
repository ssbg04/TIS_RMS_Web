---
// Footer component - Talisay Integrated School RMS
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#070e0a] border-t border-white/5 text-slate-400 py-12">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <div class="grid gap-10 md:grid-cols-3 pb-10 border-b border-white/5">

      <!-- Brand -->
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <img
            src="/tis_logo.png"
            alt="Talisay Integrated School"
            class="h-9 w-9 object-contain"
          />
          <div>
            <div class="font-display text-base font-bold text-white">TIS RMS</div>
            <div class="text-xs text-amber-400">Talisay Integrated School</div>
          </div>
        </div>
        <p class="text-sm text-slate-500 leading-relaxed max-w-xs">
          A records management system for Talisay Integrated School in Tiaong, Quezon, Philippines. Designed to digitize and manage student records from old documents dated 2021 onwards.
        </p>
      </div>

      <!-- Navigation -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold text-slate-200">Navigation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#showcase" class="hover:text-white transition">App Preview</a></li>
          <li><a href="#school-forms" class="hover:text-white transition">School Forms</a></li>
          <li><a href="#ocr-pipeline" class="hover:text-white transition">Document Scanning</a></li>
          <li><a href="#features" class="hover:text-white transition">Features</a></li>
          <li><a href="#downloads" class="hover:text-white transition">Downloads</a></li>
        </ul>
      </div>

      <!-- Downloads -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold text-slate-200">Downloads</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://github.com/ssbg04/TIS_RMS/releases/latest/download/TIS_RMS_Client_Setup.exe" target="_blank" rel="noopener noreferrer" class="hover:text-white transition flex items-center gap-1.5">
              Windows App (.exe)
              <span class="text-xs text-[#4ade80]">Latest</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/ssbg04/TIS_RMS/releases/latest/download/TIS_RMS_Android_Universal.apk" target="_blank" rel="noopener noreferrer" class="hover:text-white transition flex items-center gap-1.5">
              Android App (.apk)
              <span class="text-xs text-[#4ade80]">Latest</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/ssbg04/TIS_RMS/releases/latest" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">Release Notes</a>
          </li>
          <li>
            <a href="https://github.com/ssbg04/TIS_RMS" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">GitHub Repository</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-600">
      <div>© {currentYear} Talisay Integrated School — TIS RMS. Tiaong, Quezon, Philippines.</div>
      <div>Developed by <strong class="text-slate-400">BSIT3DSB</strong></div>
    </div>

  </div>
</footer>
