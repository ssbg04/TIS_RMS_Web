---
// Footer component - Talisay Integrated School RMS
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-50 border-t border-slate-200 text-slate-600 py-12">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <div class="grid gap-10 md:grid-cols-4 pb-10 border-b border-slate-200">

      <!-- Brand -->
      <div class="space-y-3 md:col-span-2">
        <div class="flex items-center gap-3">
          <img
            src="/tis_logo.png"
            alt="Talisay Integrated School"
            class="h-9 w-9 object-contain"
          />
          <div>
            <div class="font-display text-base font-bold text-slate-900">TIS RMS</div>
            <div class="text-xs text-[#15803d] font-semibold">Talisay Integrated School</div>
          </div>
        </div>
        <p class="text-sm text-slate-500 leading-relaxed max-w-sm">
          A dedicated records management system for Talisay Integrated School in Tiaong, Quezon, Philippines. Designed to digitize and manage learner basic profiles from historical documents 2021 onwards.
        </p>
        <div class="pt-1 text-xs text-slate-400">
          DepEd Division of Quezon · Region IV-A CALABARZON
        </div>
      </div>

      <!-- Navigation -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-slate-900">Navigation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#showcase" class="hover:text-slate-900 transition">Screenshots</a></li>
          <li><a href="#school-forms" class="hover:text-slate-900 transition">School Forms</a></li>
          <li><a href="#ocr-pipeline" class="hover:text-slate-900 transition">Document Scanning</a></li>
          <li><a href="#features" class="hover:text-slate-900 transition">Features</a></li>
          <li><a href="#downloads" class="hover:text-slate-900 transition">Downloads Hub</a></li>
        </ul>
      </div>

      <!-- Downloads -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-slate-900">Direct Downloads</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://github.com/ssbg04/TIS_RMS/releases/latest/download/TIS_RMS_Client_Setup_v1.0.27.exe" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition flex items-center gap-1.5">
              <span>Windows App (.exe)</span>
              <span class="text-[11px] font-semibold text-[#15803d] bg-emerald-50 px-1.5 py-0.2 rounded border border-emerald-200">Win 10/11</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/ssbg04/TIS_RMS/releases/latest/download/TIS_RMS_Universal_v1.0.27.apk" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition flex items-center gap-1.5">
              <span>Android Universal (.apk)</span>
              <span class="text-[11px] font-semibold text-[#15803d] bg-emerald-50 px-1.5 py-0.2 rounded border border-emerald-200">All Devices</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/ssbg04/TIS_RMS/releases/latest/download/TIS_RMS_64_v1.0.27.apk" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition flex items-center gap-1.5">
              <span>Android 64-bit (.apk)</span>
              <span class="text-[11px] text-blue-600 bg-blue-50 px-1.5 py-0.2 rounded border border-blue-200">arm64</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/ssbg04/TIS_RMS/releases/latest/download/TIS_RMS_32bit_v1.0.27.apk" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition flex items-center gap-1.5">
              <span>Android 32-bit (.apk)</span>
              <span class="text-[11px] text-amber-700 bg-amber-50 px-1.5 py-0.2 rounded border border-amber-200">v7a</span>
            </a>
          </li>
          <li class="pt-1">
            <a href="https://github.com/ssbg04/TIS_RMS/releases/latest" target="_blank" rel="noopener noreferrer" class="text-xs text-slate-500 hover:text-slate-800 transition">
              View GitHub Releases →
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <div>© {currentYear} Talisay Integrated School — TIS RMS. Tiaong, Quezon, Philippines.</div>
      <div>Developed by <strong class="text-slate-700 font-semibold">BSIT3DSB</strong></div>
    </div>

  </div>
</footer>
