            <div class="flex items-center justify-between border-b border-[#1f3627] pb-3">
              <span class="font-display text-sm font-bold text-white">Student Records (2021 Onwards)</span>
              <div class="flex items-center gap-2">
                <span class="rounded-md bg-[#16a34a] px-2.5 py-1 text-xs font-semibold text-white">+ Register Info</span>
              </div>
            </div>

            <!-- Directory Table Row Snapshot -->
            <div class="mt-4 space-y-2.5">
              <div class="rounded-xl border border-[#254231] bg-[#112017] p-3.5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-3">
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#16a34a]/20 text-[#4ade80] font-bold font-mono text-xs">
                      G
                    </div>
                    <div>
                      <div class="font-display text-sm font-bold text-white">GARCIA, CRIS CHARLES</div>
                      <div class="text-[11px] font-mono text-emerald-400">LRN: 108297100170</div>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 text-xs">
                    <span class="rounded bg-[#1a3424] px-2 py-0.5 font-mono text-slate-300 text-[11px]">
                      S.Y. 2021-2022
                    </span>
                    <span class="rounded bg-[#143d24] px-2 py-0.5 text-[11px] font-semibold text-[#4ade80]">
                      Registered (2021+)
                    </span>
                    <span class="rounded bg-amber-500/15 border border-amber-500/30 px-2 py-0.5 text-[11px] font-semibold text-amber-400">
                      SF-10 & SF-9 Record
                    </span>
                  </div>
                </div>
              </div>

              <div class="rounded-xl border border-[#254231] bg-[#112017] p-3.5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-3">
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600/20 text-blue-400 font-bold font-mono text-xs">
                      M
                    </div>
                    <div>
                      <div class="font-display text-sm font-bold text-white">MENDOZA, ALYSSA MAE</div>
                      <div class="text-[11px] font-mono text-emerald-400">LRN: 108297100284</div>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 text-xs">
                    <span class="rounded bg-[#1a3424] px-2 py-0.5 font-mono text-slate-300 text-[11px]">
                      S.Y. 2022-2023
                    </span>
                    <span class="rounded bg-[#143d24] px-2 py-0.5 text-[11px] font-semibold text-[#4ade80]">
                      Registered (2021+)
                    </span>
                    <span class="rounded bg-[#16a34a]/20 border border-[#16a34a]/30 px-2 py-0.5 text-[11px] font-semibold text-[#4ade80]">
                      SF-10 & SF-9 Record
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 3 Content: Basic Info Registration via SF10 & SF9 (Not Enrollment) -->
      <div id="hero-tab-content-docs" class="hero-tab-content hidden p-5 sm:p-7">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5 space-y-4">
            <div class="inline-flex items-center gap-2 rounded-lg bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-400 border border-amber-500/20">
              <span>Efficient Registration Method</span>
            </div>
            <h3 class="font-display text-xl font-bold text-white sm:text-2xl">
              Basic Info Registration via SF10 & SF9
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              SF10 and SF9 documents provide the most efficient method to capture and register student basic information into the system.
            </p>
            <div class="rounded-xl border border-amber-500/25 bg-amber-500/10 p-3 text-xs text-amber-300 leading-relaxed">
              <strong class="text-amber-200">Important Note:</strong> This is <strong>not an enrollment system</strong>. TIS RMS is built strictly for the management and basic registration of student information from old documents dated <strong>2021 onwards</strong>.
            </div>
          </div>

          <div class="lg:col-span-7 overflow-hidden rounded-2xl border border-[#23412f] bg-[#09110c] p-4">
            <div class="flex items-center justify-between border-b border-[#1f3627] pb-3 text-xs font-mono">
              <span class="text-white font-bold">SF10 & SF9 Registration Framework</span>
              <span class="text-emerald-400 font-semibold">2021 Onwards Focus</span>
