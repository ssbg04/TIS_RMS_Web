---
// Hero component - Talisay Integrated School Records Management System
---

<section class="relative overflow-hidden pt-32 pb-24 lg:pt-40 lg:pb-32">

  <!-- Soft background glow -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute left-1/2 -top-24 h-[480px] w-[700px] -translate-x-1/2 rounded-full bg-[#16a34a]/15 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-4xl px-5 sm:px-8 text-center">

    <!-- School badge -->
    <div class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-slate-300">
      <img src="/tis_logo.png" alt="TIS Logo" class="h-5 w-5 object-contain" width="20" height="20" />
      <span class="text-amber-400 font-semibold">Talisay Integrated School</span>
      <span class="text-slate-500">•</span>
      <span>Tiaong, Quezon</span>
    </div>

    <!-- Headline -->
    <h1 class="font-display text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl">
      Student Records,<br class="hidden sm:inline" />
      <span class="text-[#4ade80]"> Made Simple.</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
      TIS RMS helps Talisay Integrated School staff digitize, organize, and look up student records from old school documents — all stored safely on school computers, no internet needed.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#downloads"
        class="inline-flex items-center gap-2 rounded-xl bg-[#16a34a] px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-[#16a34a]/20 transition hover:bg-[#15803d]"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download the App
      </a>

      <a
        href="#showcase"
        class="inline-flex items-center rounded-xl border border-white/10 bg-white/5 px-7 py-3.5 text-base font-semibold text-slate-200 transition hover:bg-white/10 hover:text-white"
      >
        See How It Looks
      </a>
    </div>

    <!-- Quick facts -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3 text-sm text-slate-400">
      <span class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-[#4ade80]"></span>
        Windows &amp; Android
      </span>
      <span class="text-slate-600">·</span>
      <span class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
        100% Offline — Works on School Wi-Fi
      </span>
      <span class="text-slate-600">·</span>
      <span class="flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-[#4ade80]"></span>
        Free for All TIS Staff
      </span>
    </div>

  </div>

  <!-- Simple 4-highlight cards -->
  <div class="mx-auto mt-20 max-w-5xl px-5 sm:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

      <div class="rounded-2xl border border-white/8 bg-white/3 p-5 transition hover:bg-white/6">
        <div class="text-2xl mb-3">📋</div>
        <h3 class="font-display text-base font-semibold text-white">SF-10 &amp; SF-9 Records</h3>
        <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Register student basic info from official school forms quickly.</p>
      </div>

      <div class="rounded-2xl border border-white/8 bg-white/3 p-5 transition hover:bg-white/6">
        <div class="text-2xl mb-3">🗂️</div>
        <h3 class="font-display text-base font-semibold text-white">Document Archive</h3>
        <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Organize historical student records from 2021 onwards in one place.</p>
      </div>

      <div class="rounded-2xl border border-white/8 bg-white/3 p-5 transition hover:bg-white/6">
        <div class="text-2xl mb-3">📷</div>
        <h3 class="font-display text-base font-semibold text-white">Scan Documents</h3>
        <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Use your Android phone to scan paper documents — the app reads the text automatically.</p>
      </div>

      <div class="rounded-2xl border border-white/8 bg-white/3 p-5 transition hover:bg-white/6">
        <div class="text-2xl mb-3">🔒</div>
        <h3 class="font-display text-base font-semibold text-white">Private &amp; Offline</h3>
        <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">Student data stays on school computers. No cloud, no internet required.</p>
      </div>

    </div>
  </div>

</section>
