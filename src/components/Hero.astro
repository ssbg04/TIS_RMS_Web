<script>
  // Interactive Hero Tabs for Teachers
  const heroTabs = document.querySelectorAll<HTMLButtonElement>('.hero-tab-btn');
  const heroContents = document.querySelectorAll<HTMLElement>('.hero-tab-content');

  heroTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.heroTab;

      // Update button active state
      heroTabs.forEach((t) => {
        t.classList.remove('bg-[#16a34a]', 'text-white', 'shadow-md');
        t.classList.add('bg-[#16271c]', 'text-slate-300', 'border', 'border-[#23412f]');
      });

      tab.classList.remove('bg-[#16271c]', 'text-slate-300', 'border', 'border-[#23412f]');
      tab.classList.add('bg-[#16a34a]', 'text-white', 'shadow-md');

      // Update active content
      heroContents.forEach((c) => {
        if (c.id === `hero-tab-content-${target}`) {
          c.classList.remove('hidden');
          c.classList.add('block');
        } else {
          c.classList.add('hidden');
          c.classList.remove('block');
        }
      });
    });
  });
</script>
