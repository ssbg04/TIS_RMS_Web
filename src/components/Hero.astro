<script>
  const pills = document.querySelectorAll<HTMLButtonElement>(".module-pill");
  const previewText = document.getElementById("module-preview-text");

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => {
        p.classList.remove("active");
        p.setAttribute("aria-selected", "false");
      });
      pill.classList.add("active");
      pill.setAttribute("aria-selected", "true");
      if (previewText) {
        previewText.textContent = pill.dataset.text || "";
      }
    });
  });
</script>
