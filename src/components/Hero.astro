---
// Hero component - Talisay Integrated School Records Management System
---

<section class="relative overflow-hidden pt-32 pb-20 lg:pt-40 lg:pb-28">

  <!-- Soft ambient background light -->
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute left-1/2 -top-24 h-[440px] w-[720px] -translate-x-1/2 rounded-full bg-emerald-500/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-4xl px-5 sm:px-8 text-center">

    <!-- School badge -->
    <div class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm text-slate-700 shadow-xs">
      <img src="/tis_logo.png" alt="TIS Logo" class="h-5 w-5 object-contain" width="20" height="20" />
      <span class="text-[#15803d] font-semibold">Talisay Integrated School</span>
      <span class="text-slate-300">•</span>
      <span class="text-slate-600">Tiaong, Quezon</span>
    </div>

    <!-- Headline -->
    <h1 class="font-display text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl lg:text-7xl">
      Student Records,<br class="hidden sm:inline" />
      <span class="text-[#15803d]"> Made Simple.</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
      TIS RMS helps Talisay Integrated School staff digitize, organize, and look up student records from old school documents — all stored safely on school computers, no internet needed.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#downloads"
        class="inline-flex items-center gap-2 rounded-xl bg-[#15803d] px-7 py-3.5 text-base font-semibold text-white shadow-md shadow-[#15803d]/20 transition hover:bg-[#166534]"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        Download the App
      </a>

      <a
        href="#showcase"
        class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-7 py-3.5 text-base font-semibold text-slate-700 shadow-xs transition hover:bg-slate-50 hover:border-slate-300"
      >
        See How It Looks
      </a>
    </div>

    <!-- Quick facts -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3 text-sm text-slate-600">
      <span class="flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-[#15803d]"></span>
        Windows &amp; Android
      </span>
      <span class="text-slate-300">·</span>
      <span class="flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-amber-500"></span>
        100% Offline — Works on School Wi-Fi
      </span>
      <span class="text-slate-300">·</span>
      <span class="flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-[#15803d]"></span>
        Free for All TIS Staff
      </span>
    </div>

  </div>

  <!-- 4-highlight cards -->
  <div class="mx-auto mt-16 max-w-5xl px-5 sm:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

      <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-md hover:border-slate-300">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#ecfdf5] text-xl mb-3.5">📋</div>
        <h3 class="font-display text-base font-bold text-slate-900">SF-10 &amp; SF-9 Records</h3>
        <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">Register student basic info from official school forms quickly.</p>
      </div>

      <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-md hover:border-slate-300">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#eff6ff] text-xl mb-3.5">🗂️</div>
        <h3 class="font-display text-base font-bold text-slate-900">Document Archive</h3>
        <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">Organize historical student records from 2021 onwards in one place.</p>
      </div>

      <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-md hover:border-slate-300">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#fffbeb] text-xl mb-3.5">📷</div>
        <h3 class="font-display text-base font-bold text-slate-900">Scan Documents</h3>
        <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">Use your Android phone to scan paper documents — the app reads text automatically.</p>
      </div>

      <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-md hover:border-slate-300">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#ecfdf5] text-xl mb-3.5">🔒</div>
        <h3 class="font-display text-base font-bold text-slate-900">Private &amp; Offline</h3>
        <p class="mt-1.5 text-sm text-slate-600 leading-relaxed">Student data stays on school computers. No cloud, no external servers required.</p>
      </div>

    </div>
  </div>

</section>
