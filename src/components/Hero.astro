              </div>
              <span class="rounded bg-[#16a34a]/20 px-2.5 py-1 text-[10px] font-mono text-[#4ade80] font-bold border border-[#16a34a]/30">
                2021+ Document Register
              </span>
            </div>

            <!-- Student Snapshot in Sheet -->
            <div class="mt-3 grid grid-cols-2 gap-2 text-[11px] font-mono sm:grid-cols-4 bg-[#111f16] p-2.5 rounded-xl border border-[#1f3627]">
              <div>
                <span class="text-slate-500 block text-[10px]">LRN:</span>
                <span class="text-emerald-400 font-bold">108297100170</span>
              </div>
              <div>
                <span class="text-slate-500 block text-[10px]">LEARNER NAME:</span>
                <span class="text-white font-bold">GARCIA, CRIS CHARLES</span>
              </div>
              <div>
                <span class="text-slate-500 block text-[10px]">YEAR LEVEL:</span>
                <span class="text-amber-400 font-bold">Grade 7</span>
              </div>
              <div>
                <span class="text-slate-500 block text-[10px]">ARCHIVE YEAR:</span>
                <span class="text-white font-bold">2021-2022</span>
              </div>
            </div>

            <!-- Basic Student Info Extracted Fields Table (Not Grades) -->
            <div class="mt-3 overflow-x-auto">
              <table class="w-full text-left text-xs font-mono">
                <thead>
                  <tr class="border-b border-[#1f3627] text-[11px] text-slate-400">
                    <th class="py-1.5">Registered Field</th>
                    <th class="py-1.5">Archived Document Value</th>
                    <th class="py-1.5 text-right">Verification</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#1f3627]/50 text-[11px] text-slate-300">
                  <tr>
                    <td class="py-1.5 text-white">Date of Birth</td>
                    <td>April 14, 2009</td>
                    <td class="text-right text-[#4ade80]">Verified (SF10)</td>
                  </tr>
                  <tr>
                    <td class="py-1.5 text-white">Sex</td>
                    <td>Male</td>
                    <td class="text-right text-[#4ade80]">Verified (SF10)</td>
                  </tr>
                  <tr>
                    <td class="py-1.5 text-white">Originating School</td>
                    <td>Talisay Elementary School</td>
                    <td class="text-right text-[#4ade80]">Historical Record</td>
                  </tr>
                  <tr>
                    <td class="py-1.5 text-white">Document Source</td>
                    <td>SF-10 / SF-9 Document (2021 Onwards)</td>
                    <td class="text-right text-amber-400">Cataloged</td>
                  </tr>
                  <tr>
                    <td class="py-1.5 text-white">System Role</td>
                    <td>Basic Student Info Only</td>
                    <td class="text-right text-slate-400">No Grade Tracking</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Footer of Sheet Preview -->
            <div class="mt-3 flex items-center justify-between border-t border-[#1f3627] pt-3 text-xs font-mono">
              <div class="text-slate-400">
                Registration Type: <strong class="text-emerald-400">Basic Info Only (Not Enrollment)</strong>
              </div>
              <span class="rounded bg-emerald-500/10 px-2 py-0.5 text-[10px] text-emerald-400">
                Archived S.Y. 2021+
              </span>
            </div>
          </div>

        </div>
      </div>

      <!-- Tab 2 Content: Student & LRN Directory Preview -->
      <div id="hero-tab-content-students" class="hero-tab-content hidden p-5 sm:p-7">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5 space-y-4">
            <div class="inline-flex items-center gap-2 rounded-lg bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-400 border border-emerald-500/20">
              <span>Historical Student Directory</span>
            </div>
            <h3 class="font-display text-xl font-bold text-white sm:text-2xl">
              Student Lookup by LRN or Name
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Find any archived learner record from 2021 onwards. Check their 4Ps classification, basic profile information, and registered SF-10 / SF-9 documents.
            </p>
            <div class="flex items-center gap-3 pt-2">
              <span class="rounded-lg bg-[#16a34a]/20 border border-[#16a34a]/40 px-3 py-1.5 text-xs font-mono text-[#4ade80]">
                + Register Student Info
              </span>
              <span class="rounded-lg bg-slate-800 border border-slate-700 px-3 py-1.5 text-xs font-mono text-slate-300">
                Export Directory List
              </span>
