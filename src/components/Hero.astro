<script>
  // ── Smart Download Button + APK Modal Logic ───────────────────────────────
  (function initSmartHeroDownload() {
    const CACHE_KEY    = "tis-rms-release-cache";
    const RELEASES_API = "https://api.github.com/repos/ssbg04/TIS_RMS/releases/latest";
    const RELEASES_URL = "https://github.com/ssbg04/TIS_RMS/releases/latest";

    // Known stable assets (v2.0.62) for instant synchronous assignment
    let currentAssets = {
      windows: {
        name: "TIS_RMS_Client_Setup_v2.0.62.exe",
        url: "https://github.com/ssbg04/TIS_RMS/releases/download/v2.0.62/TIS_RMS_Client_Setup_v2.0.62.exe",
        size: "38.4 MB"
      },
      universal: {
        name: "TIS_RMS_Universal_v2.0.62.apk",
        url: "https://github.com/ssbg04/TIS_RMS/releases/download/v2.0.62/TIS_RMS_Universal_v2.0.62.apk",
        size: "66.9 MB"
      },
      arm64: {
        name: "TIS_RMS_64_v2.0.62.apk",
        url: "https://github.com/ssbg04/TIS_RMS/releases/download/v2.0.62/TIS_RMS_64_v2.0.62.apk",
        size: "25.8 MB"
      },
      armeabi: {
        name: "TIS_RMS_32bit_v2.0.62.apk",
        url: "https://github.com/ssbg04/TIS_RMS/releases/download/v2.0.62/TIS_RMS_32bit_v2.0.62.apk",
        size: "23.6 MB"
      }
    };

    const btn           = document.getElementById("hero-download-btn") as HTMLAnchorElement | null;
    const label         = document.getElementById("hero-download-label");
    const iconContainer = document.getElementById("hero-download-icon");
    const cantInstall   = document.getElementById("cant-install-hint") as HTMLButtonElement | null;

    // Modal elements
    const backdrop       = document.getElementById("apk-modal-backdrop") as HTMLElement | null;
    const modalClose     = document.getElementById("apk-modal-close");
    const universalLink  = document.getElementById("modal-universal-link") as HTMLAnchorElement | null;
    const arm64Link      = document.getElementById("modal-arm64-link") as HTMLAnchorElement | null;
    const armeabiLink    = document.getElementById("modal-armeabi-link") as HTMLAnchorElement | null;
    const universalSize  = document.getElementById("modal-universal-size");
    const arm64Size      = document.getElementById("modal-arm64-size");
    const armeabiSize    = document.getElementById("modal-armeabi-size");
    const arm64Badge     = document.getElementById("modal-arm64-badge");
    const armeabiBadge   = document.getElementById("modal-armeabi-badge");

    const windowsIconSvg = `<svg class="hero-dl-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 4.2 10.8 3v8.1H2V4.2Zm10-1.35L22 1.5v9.6H12v-8.25ZM2 12.8h8.8v8.1L2 19.65v-6.85Zm10 0h10v9.7l-10-1.4v-8.3Z"/></svg>`;
    const androidIconSvg = `<svg class="hero-dl-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 9.6a.72.72 0 1 0 0 1.44.72.72 0 0 0 0-1.44Zm11.64 0a.72.72 0 1 0 0 1.44.72.72 0 0 0 0-1.44ZM15.66 3.3l1.2-2.08a.3.3 0 0 0-.52-.3l-1.22 2.12A7.44 7.44 0 0 0 12 2.4a7.44 7.44 0 0 0-3.12.64L7.66.92a.3.3 0 0 0-.52.3l1.2 2.08A6.72 6.72 0 0 0 5.28 8.4h13.44A6.72 6.72 0 0 0 15.66 3.3ZM5.28 9.6v7.08a1.44 1.44 0 0 0 1.44 1.44h.72V21a1.2 1.2 0 0 0 2.4 0v-2.88h4.32V21a1.2 1.2 0 0 0 2.4 0v-2.88h.72a1.44 1.44 0 0 0 1.44-1.44V9.6H5.28ZM3 9.6a1.2 1.2 0 0 0-1.2 1.2v4.8a1.2 1.2 0 0 0 2.4 0V10.8A1.2 1.2 0 0 0 3 9.6Zm18 0a1.2 1.2 0 0 0-1.2 1.2v4.8a1.2 1.2 0 0 0 2.4 0V10.8A1.2 1.2 0 0 0 21 9.6Z"/></svg>`;

    // ── Platform & Architecture Detection ────────────────────────────────────
    function detectPlatformAndArch(): {
      platform: "windows" | "android" | "other";
      arch: "64" | "32";
      archLabel: "64-bit" | "32-bit";
    } {
      const ua = navigator.userAgent || "";
      const nav = navigator as any;
      const platformStr = (nav.userAgentData?.platform || navigator.platform || ua).toLowerCase();

      const isAndroid = /android/i.test(ua) || platformStr.includes("android");
      const isWindows = /windows|win32|win64/i.test(ua) || platformStr.includes("win");

      if (isWindows) {
        const is64 = /x64|x86_64|win64|wow64/i.test(ua) || (nav.userAgentData?.bitness === "64");
        return {
          platform: "windows",
          arch: is64 ? "64" : "32",
          archLabel: is64 ? "64-bit" : "32-bit"
        };
      }

      if (isAndroid) {
        // Look for 32-bit markers (armv7, armeabi). Modern Android devices since 2017 are overwhelmingly 64-bit ARM64.
        const is32 = /armv7|armeabi/i.test(ua);
        return {
          platform: "android",
          arch: is32 ? "32" : "64",
          archLabel: is32 ? "32-bit" : "64-bit"
        };
      }

      return {
        platform: "other",
        arch: "64",
        archLabel: "64-bit"
      };
    }

    // ── Apply direct download to Hero CTA ────────────────────────────────────
    function applyHeroDownload(info: ReturnType<typeof detectPlatformAndArch>) {
      if (!btn) return;

      if (info.platform === "windows") {
        btn.href = currentAssets.windows.url;
        btn.setAttribute("download", currentAssets.windows.name);
        btn.setAttribute("target", "_blank");
        btn.setAttribute("rel", "noopener noreferrer");
        if (label) label.textContent = `Download for Windows (${info.archLabel})`;
        btn.setAttribute("aria-label", `Download TIS RMS for Windows ${info.archLabel}`);
        if (iconContainer) iconContainer.innerHTML = windowsIconSvg;
        if (cantInstall) cantInstall.hidden = true;
      } else if (info.platform === "android") {
        const chosen = info.arch === "32" ? currentAssets.armeabi : currentAssets.arm64;
        btn.href = chosen.url;
        btn.setAttribute("download", chosen.name);
        btn.setAttribute("target", "_blank");
        btn.setAttribute("rel", "noopener noreferrer");
        if (label) label.textContent = `Download for Android (${info.archLabel})`;
        btn.setAttribute("aria-label", `Download TIS RMS for Android ${info.archLabel}`);
        if (iconContainer) iconContainer.innerHTML = androidIconSvg;
        if (cantInstall) cantInstall.hidden = false;
      } else {
        btn.href = "#downloads";
        btn.removeAttribute("download");
        btn.removeAttribute("target");
        btn.removeAttribute("rel");
        if (label) label.textContent = "View All Downloads";
        btn.setAttribute("aria-label", "View All Downloads");
        if (cantInstall) cantInstall.hidden = true;
      }

      // Update modal badges
      if (arm64Badge) arm64Badge.textContent = (info.platform === "android" && info.arch === "64") ? "Your device" : "";
      if (armeabiBadge) armeabiBadge.textContent = (info.platform === "android" && info.arch === "32") ? "Your device" : "";
      arm64Link?.classList.toggle("apk-option-detected", info.platform === "android" && info.arch === "64");
      armeabiLink?.classList.toggle("apk-option-detected", info.platform === "android" && info.arch === "32");
    }

    // ── Update Modal Download Links ──────────────────────────────────────────
    function updateModalUI() {
      if (universalLink) {
        universalLink.href = currentAssets.universal.url;
        universalLink.setAttribute("download", currentAssets.universal.name);
      }
      if (arm64Link) {
        arm64Link.href = currentAssets.arm64.url;
        arm64Link.setAttribute("download", currentAssets.arm64.name);
      }
      if (armeabiLink) {
        armeabiLink.href = currentAssets.armeabi.url;
        armeabiLink.setAttribute("download", currentAssets.armeabi.name);
      }
      if (universalSize) universalSize.textContent = currentAssets.universal.size;
      if (arm64Size) arm64Size.textContent = currentAssets.arm64.size;
      if (armeabiSize) armeabiSize.textContent = currentAssets.armeabi.size;
    }

    // ── Modal open / close ──────────────────────────────────────────────────
    function openModal() {
      if (!backdrop) return;
      backdrop.hidden = false;
      backdrop.classList.add("is-open");
      document.body.style.overflow = "hidden";
      modalClose?.focus();
    }

    function closeModal() {
      if (!backdrop) return;
      backdrop.classList.remove("is-open");
      backdrop.hidden = true;
      document.body.style.overflow = "";
      cantInstall?.focus();
    }

    modalClose?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", (e) => {
      if (e.target === backdrop) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && backdrop && !backdrop.hidden) closeModal();
    });

    cantInstall?.addEventListener("click", openModal);

    // ── Android Direct Download Helper (Bypasses GitHub App Redirection) ────
    function triggerAndroidDownload(url: string) {
      const iframe = document.createElement("iframe");
      iframe.style.position = "fixed";
      iframe.style.top = "0";
      iframe.style.left = "0";
      iframe.style.width = "1px";
      iframe.style.height = "1px";
      iframe.style.opacity = "0.01";
      iframe.style.pointerEvents = "none";
      iframe.style.border = "none";
      iframe.src = url;
      document.body.appendChild(iframe);
      setTimeout(() => {
        try { iframe.remove(); } catch (_) {}
      }, 30000);
    }

    // Modal Android links: intercept click on Android to avoid opening GitHub app
    function setupModalAndroidLink(link: HTMLAnchorElement | null) {
      link?.addEventListener("click", (e) => {
        const isAndroid = /android/i.test(navigator.userAgent || "");
        if (isAndroid && link.href) {
          e.preventDefault();
          triggerAndroidDownload(link.href);
          closeModal();
        }
      });
    }
    setupModalAndroidLink(universalLink);
    setupModalAndroidLink(arm64Link);
    setupModalAndroidLink(armeabiLink);

    // Hero button click handler: bypass GitHub app on Android, direct download on Windows
    btn?.addEventListener("click", (e) => {
      const isAndroid = /android/i.test(navigator.userAgent || "");
      if (isAndroid) {
        e.preventDefault();
        const cur = detectPlatformAndArch();
        const chosen = cur.arch === "32" ? currentAssets.armeabi : currentAssets.arm64;
        triggerAndroidDownload(chosen.url);
        return;
      }
      const href = btn.getAttribute("href") || "";
      if (href === "#downloads" || href.startsWith("#")) {
        const cur = detectPlatformAndArch();
        if (cur.platform === "windows") {
          e.preventDefault();
          window.location.href = currentAssets.windows.url;
        }
      }
    });

    // ── 1. Run Synchronously Now (Zero Delay) ────────────────────────────────
    let detected = detectPlatformAndArch();
    applyHeroDownload(detected);
    updateModalUI();

    // ── 2. Refine Architecture Asynchronously with User-Agent Client Hints ──
    const nav = navigator as any;
    if (nav.userAgentData?.getHighEntropyValues) {
      nav.userAgentData.getHighEntropyValues(["architecture", "bitness"]).then((hints: any) => {
        const archStr = String(hints.architecture || "").toLowerCase();
        const bitsStr = String(hints.bitness || "");
        let changed = false;

        if (detected.platform === "android") {
          if (bitsStr === "32" || (archStr.includes("arm") && bitsStr === "32")) {
            if (detected.arch !== "32") {
              detected.arch = "32";
              detected.archLabel = "32-bit";
              changed = true;
            }
          }
        } else if (detected.platform === "windows") {
          if (bitsStr === "32") {
            if (detected.arch !== "32") {
              detected.arch = "32";
              detected.archLabel = "32-bit";
              changed = true;
            }
          }
        }

        if (changed) {
          applyHeroDownload(detected);
        }
      }).catch(() => {});
    }

    // ── 3. Check GitHub Releases in Background for Newer Versions ───────────
    function formatSize(bytes: number) {
      return bytes ? `${(bytes / (1024 * 1024)).toFixed(1)} MB` : "";
    }

    async function checkLatestReleases() {
      try {
        let release: any;
        const cached = sessionStorage.getItem(CACHE_KEY);
        if (cached) {
          release = JSON.parse(cached);
        } else {
          const res = await fetch(RELEASES_API, {
            headers: { Accept: "application/vnd.github+json" },
          });
          if (!res.ok) return;
          release = await res.json();
          sessionStorage.setItem(CACHE_KEY, JSON.stringify(release));
        }

        const assets: any[] = release?.assets || [];
        const winAsset = assets.find((a) => /\.exe$/i.test(a.name));
        const uniAsset = assets.find((a) => /universal.*\.apk$/i.test(a.name));
        const a64Asset = assets.find((a) => /(?:64|arm64|arm_64).*\.apk$/i.test(a.name) && !/universal/i.test(a.name));
        const a32Asset = assets.find((a) => /(?:32|v7a|armeabi).*\.apk$/i.test(a.name) && !/universal/i.test(a.name));

        if (winAsset) {
          currentAssets.windows = {
            name: winAsset.name,
            url: winAsset.browser_download_url,
            size: formatSize(winAsset.size)
          };
        }
        if (uniAsset) {
          currentAssets.universal = {
            name: uniAsset.name,
            url: uniAsset.browser_download_url,
            size: formatSize(uniAsset.size)
          };
        }
        if (a64Asset) {
          currentAssets.arm64 = {
            name: a64Asset.name,
            url: a64Asset.browser_download_url,
            size: formatSize(a64Asset.size)
          };
        }
        if (a32Asset) {
          currentAssets.armeabi = {
            name: a32Asset.name,
            url: a32Asset.browser_download_url,
            size: formatSize(a32Asset.size)
          };
        }

        applyHeroDownload(detected);
        updateModalUI();
      } catch {
        // Fallback already assigned synchronously!
      }
    }

    checkLatestReleases();
  })();

  // ── Interactive Module Showcase Tabs ──────────────────────────────────────
  const pills = document.querySelectorAll<HTMLButtonElement>(".module-pill");
  const previewText = document.getElementById("module-preview-text");

  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      pills.forEach((p) => {
        p.classList.remove("active");
        p.setAttribute("aria-selected", "false");
      });
      pill.classList.add("active");
      pill.setAttribute("aria-selected", "true");
      if (previewText) {
        previewText.style.opacity = "0";
        setTimeout(() => {
          previewText.textContent = pill.dataset.text || "";
          previewText.style.opacity = "1";
        }, 120);
      }
    });
  });
</script>
