---
// Hero component - Focused on Talisay Integrated School teachers and top RMS features
---

<section class="relative overflow-hidden pt-32 pb-20 lg:pt-36 lg:pb-28">
  <!-- Glowing Background Orbs & Radial Gradients matching app screenshots -->
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute left-1/2 -top-32 h-[550px] w-[850px] -translate-x-1/2 rounded-full bg-gradient-to-b from-[#16a34a]/25 via-[#15803d]/10 to-transparent blur-3xl"></div>
    <div class="absolute right-[-10%] top-1/4 h-96 w-96 rounded-full bg-[#f59e0b]/10 blur-3xl"></div>
    <div class="absolute left-[-10%] bottom-10 h-80 w-80 rounded-full bg-[#22c55e]/10 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header / Intro -->
    <div class="mx-auto max-w-4xl text-center">

      <!-- Official School Identity Pill -->
      <div class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-[#2a4c37] bg-[#112017]/90 px-4 py-2 text-xs font-semibold text-[#a7f3d0] shadow-lg shadow-[#16a34a]/10 backdrop-blur-md">
        <img
          src="/tis_logo.png"
          alt="TIS Logo"
          class="h-5 w-5 object-contain"
          width="20"
          height="20"
        />
        <span class="text-amber-400 font-bold">Talisay Integrated School</span>
        <span class="text-slate-500">•</span>
        <span class="text-slate-300">Tiaong, Quezon, Philippines</span>
        <span class="hidden sm:inline-flex rounded-full bg-[#16a34a]/25 px-2 py-0.5 text-[10px] font-bold text-[#4ade80]">
          DepEd Division of Quezon
        </span>
      </div>

      <!-- Main Teacher-Friendly Headline -->
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl leading-[1.08]">
        The Record Management System <br class="hidden sm:inline" />
        built for <span class="bg-gradient-to-r from-[#4ade80] via-[#22c55e] to-[#f59e0b] bg-clip-text text-transparent">Talisay Integrated School Teachers.</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base text-slate-300 sm:text-lg sm:leading-8 font-normal max-w-3xl mx-auto">
        TIS RMS simplifies record-keeping for class advisers and school staff in Tiaong, Quezon. Generate official <strong>DepEd School Form 10 (SF-10 JHS/SHS)</strong>, track student LRNs and document requirements, scan physical records with <strong>Tesseract OCR</strong>, and work uninterrupted on your <strong>offline campus LAN</strong>.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#downloads"
          class="group inline-flex items-center gap-2.5 rounded-xl bg-gradient-to-r from-[#16a34a] to-[#15803d] px-6 py-3.5 text-sm font-semibold text-white shadow-xl shadow-[#16a34a]/30 transition-all duration-200 hover:from-[#15803d] hover:to-[#0f5c2b] hover:shadow-2xl hover:shadow-[#16a34a]/40 hover:-translate-y-0.5"
        >
          <svg class="h-5 w-5 transition-transform duration-200 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Get Windows & Android App</span>
        </a>

        <a
          href="#hero-console"
          class="inline-flex items-center gap-2 rounded-xl border border-[#2a4c37] bg-[#132219]/80 px-6 py-3.5 text-sm font-semibold text-slate-200 shadow-sm backdrop-blur-sm transition hover:border-[#16a34a]/60 hover:bg-[#182c20] hover:text-white"
        >
          <svg class="h-4 w-4 text-[#4ade80]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span>Try Interactive Teacher Demo</span>
        </a>
      </div>

      <!-- Quick Platform Support Pills -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-xs font-medium text-slate-400">
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M0 3.449L9.75 2.1v9.451H0m10.95-9.6L24 0v11.4H10.95M0 12.6h9.75v9.451L0 20.699M10.95 12.6H24V24l-13.05-1.8" />
          </svg>
          <span>Windows Desktop App</span>
        </div>

        <span class="text-slate-600">•</span>

        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.552 0 .9997.4482.9997.9993s-.4477.9997-.9997.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.552 0 .9997.4482.9997.9993s-.4477.9997-.9997.9997m11.405-6.0028l1.9973-3.4592c.1192-.2066.0486-.4715-.158-.5907-.2066-.1192-.4715-.0486-.5907.158l-2.0238 3.505c-1.4646-.6692-3.1235-1.0505-4.8988-1.0772v-.0063c-1.7753.0267-3.4342.408-4.8988 1.0772l-2.0238-3.505c-.1192-.2066-.3841-.2772-.5907-.158-.2066.1192-.2772.3841-.158.5907l1.9973 3.4592c-3.1368 1.7061-5.2638 4.8875-5.5267 8.618h22.4095c-.2629-3.7305-2.3899-6.9119-5.5267-8.618" />
          </svg>
          <span>Android Mobile Scanner</span>
        </div>

        <span class="text-slate-600">•</span>

        <div class="flex items-center gap-1.5 text-amber-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>100% Offline Campus LAN</span>
        </div>
      </div>

    </div>

    <!-- Highlights Ticker: 4 Best Features Spotlight -->
    <div id="hero-features" class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      
      <!-- Feature 1: DepEd SF-10 -->
      <div class="group relative overflow-hidden rounded-2xl border border-[#233e2e] bg-[#112017]/90 p-5 shadow-lg transition duration-300 hover:border-[#16a34a] hover:bg-[#14261c] hover:-translate-y-1">
        <div class="flex items-center gap-3.5">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#16a34a]/20 text-[#4ade80] border border-[#16a34a]/30">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <div class="font-display text-base font-bold text-white">DepEd SF-10 Export</div>
            <div class="text-xs text-amber-400 font-medium">JHS & SHS v2026 Ready</div>
          </div>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-slate-300">
          Auto-populates official DepEd permanent record sheets with formulas, general averages, and promotion remarks.
        </p>
      </div>

      <!-- Feature 2: LRN & Document Checklist -->
      <div class="group relative overflow-hidden rounded-2xl border border-[#233e2e] bg-[#112017]/90 p-5 shadow-lg transition duration-300 hover:border-[#16a34a] hover:bg-[#14261c] hover:-translate-y-1">
        <div class="flex items-center gap-3.5">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#f59e0b]/20 text-[#fbbf24] border border-[#f59e0b]/30">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div class="font-display text-base font-bold text-white">LRN & Document Tracker</div>
            <div class="text-xs text-[#4ade80] font-medium">3/6 Docs Checklist</div>
          </div>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-slate-300">
          Search students by 12-digit LRN, check PSA, Form 137, and 4Ps status in seconds with visual progress bars.
        </p>
      </div>

      <!-- Feature 3: OCR Engine -->
      <div class="group relative overflow-hidden rounded-2xl border border-[#233e2e] bg-[#112017]/90 p-5 shadow-lg transition duration-300 hover:border-[#16a34a] hover:bg-[#14261c] hover:-translate-y-1">
        <div class="flex items-center gap-3.5">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-600/20 text-[#4ade80] border border-emerald-500/30">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            </svg>
          </div>
          <div>
            <div class="font-display text-base font-bold text-white">Tesseract OCR Scanner</div>
            <div class="text-xs text-slate-400 font-medium">Zero Manual Typing</div>
          </div>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-slate-300">
          Converts physical birth certificates, transcripts, and scanned reports into indexed digital records automatically.
        </p>
      </div>

      <!-- Feature 4: Local LAN Resilience -->
      <div class="group relative overflow-hidden rounded-2xl border border-[#233e2e] bg-[#112017]/90 p-5 shadow-lg transition duration-300 hover:border-[#16a34a] hover:bg-[#14261c] hover:-translate-y-1">
        <div class="flex items-center gap-3.5">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#0284c7]/20 text-[#38bdf8] border border-[#0284c7]/30">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div>
            <div class="font-display text-base font-bold text-white">Campus LAN Server</div>
            <div class="text-xs text-[#38bdf8] font-medium">No Internet Needed</div>
          </div>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-slate-300">
          Built for Talisay school environment with local SQLite database that keeps running during internet outages.
        </p>
      </div>

    </div>

    <!-- Interactive Teacher Live Console Preview -->
    <div id="hero-console" class="mt-14 overflow-hidden rounded-3xl border border-[#264332] bg-[#0c1610]/95 shadow-2xl shadow-black/80 backdrop-blur-xl">
      
      <!-- Top Titlebar matching TIS RMS Windows Application -->
      <div class="flex flex-wrap items-center justify-between border-b border-[#233e2e] bg-[#15803d] px-4 py-2.5 sm:px-6">
        <div class="flex items-center gap-3">
          <img src="/tis_logo.png" alt="TIS Seal" class="h-6 w-6 object-contain" />
          <span class="font-display text-sm font-bold text-white tracking-wide">
            TIS Record Management System — Talisay Integrated School
          </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="rounded bg-black/20 px-2 py-0.5 text-[11px] font-mono text-emerald-100">
            S.Y. 2026-2027 Active
          </span>
          <div class="hidden sm:flex items-center gap-1.5 ml-2">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-300"></span>
            <span class="text-[11px] text-white font-medium">Teacher Advisory Mode</span>
          </div>
        </div>
      </div>

      <!-- Secondary Navigation Bar inside Window -->
      <div class="flex flex-wrap items-center justify-between border-b border-[#1f3627] bg-[#101e15] px-4 py-3 sm:px-6">
        <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0">
          <button
            type="button"
            data-hero-tab="sf10"
            class="hero-tab-btn flex items-center gap-2 rounded-xl bg-[#16a34a] px-3.5 py-1.5 text-xs font-semibold text-white shadow-md transition"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>DepEd SF-10 Generator</span>
          </button>

          <button
            type="button"
            data-hero-tab="students"
            class="hero-tab-btn flex items-center gap-2 rounded-xl bg-[#16271c] px-3.5 py-1.5 text-xs font-semibold text-slate-300 border border-[#23412f] hover:bg-[#1a3023] hover:text-white transition"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <span>Student & LRN Directory</span>
          </button>

          <button
            type="button"
            data-hero-tab="docs"
            class="hero-tab-btn flex items-center gap-2 rounded-xl bg-[#16271c] px-3.5 py-1.5 text-xs font-semibold text-slate-300 border border-[#23412f] hover:bg-[#1a3023] hover:text-white transition"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z" />
            </svg>
            <span>Document Checklist (3/6 Docs)</span>
          </button>

          <button
            type="button"
            data-hero-tab="transparency"
            class="hero-tab-btn flex items-center gap-2 rounded-xl bg-[#16271c] px-3.5 py-1.5 text-xs font-semibold text-slate-300 border border-[#23412f] hover:bg-[#1a3023] hover:text-white transition"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>DepEd Transparency Board</span>
          </button>
        </div>

        <div class="hidden md:flex items-center gap-2 text-xs font-mono text-slate-400">
          <span class="inline-block h-2 w-2 rounded-full bg-[#22c55e] animate-ping"></span>
          <span>LAN IP: 192.168.1.100 (Online)</span>
        </div>
      </div>

      <!-- Tab 1 Content: DepEd SF-10 Generator Preview -->
      <div id="hero-tab-content-sf10" class="hero-tab-content block p-5 sm:p-7">
        <div class="grid gap-6 lg:grid-cols-12 lg:items-center">
          
          <div class="lg:col-span-5 space-y-4">
            <div class="inline-flex items-center gap-2 rounded-lg bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-400 border border-amber-500/20">
              <span>Automated Excel Template</span>
            </div>
            <h3 class="font-display text-xl font-bold text-white sm:text-2xl">
              DepEd School Form 10 (SF-10) in One Click
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Say goodbye to copying and pasting grades into spreadsheets manually. TIS RMS populates official DepEd templates (JHS and SHS v2026) directly from student database records with all mathematical formulas, general averages, and promotion remarks preserved.
            </p>

            <div class="space-y-2 pt-1 text-xs text-slate-300">
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-[#4ade80]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Junior High School Form 10 (Grades 7 to 10)</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-[#4ade80]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Senior High School SF-10 v2026 (Academic & TVL Strands)</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-[#4ade80]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span>Instant PDF print preview and Excel export</span>
              </div>
            </div>

            <div class="pt-2">
              <a
                href="#school-forms"
                class="inline-flex items-center gap-2 text-xs font-semibold text-[#4ade80] hover:text-white transition"
              >
                <span>Explore SF-10 Engine Features</span>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Mock Interactive SF-10 Card -->
          <div class="lg:col-span-7 overflow-hidden rounded-2xl border border-[#23412f] bg-[#09110c] p-4 sm:p-5">
            <div class="flex items-center justify-between border-b border-[#1f3627] pb-3">
              <div>
                <span class="text-xs font-mono font-bold text-amber-400">REPUBLIC OF THE PHILIPPINES — DEPED</span>
                <div class="text-sm font-bold text-white">Learner's Permanent Academic Record (SF10-JHS)</div>
              </div>
              <span class="rounded bg-[#16a34a]/20 px-2.5 py-1 text-[10px] font-mono text-[#4ade80] font-bold border border-[#16a34a]/30">
                ExcelJS Powered
              </span>
            </div>

            <!-- Student Snapshot in Sheet -->
            <div class="mt-3 grid grid-cols-2 gap-2 text-[11px] font-mono sm:grid-cols-4 bg-[#111f16] p-2.5 rounded-xl border border-[#1f3627]">
              <div>
                <span class="text-slate-500 block text-[10px]">LRN:</span>
                <span class="text-emerald-400 font-bold">108297100170</span>
              </div>
              <div>
                <span class="text-slate-500 block text-[10px]">LEARNER NAME:</span>
                <span class="text-white font-bold">GARCIA, CRIS CHARLES</span>
              </div>
              <div>
                <span class="text-slate-500 block text-[10px]">GRADE & SECTION:</span>
                <span class="text-amber-400 font-bold">Grade 7 - Susan</span>
              </div>
              <div>
                <span class="text-slate-500 block text-[10px]">SCHOOL YEAR:</span>
                <span class="text-white font-bold">2026-2027</span>
              </div>
            </div>

            <!-- Learning Areas Table -->
            <div class="mt-3 overflow-x-auto">
              <table class="w-full text-left text-xs font-mono">
                <thead>
                  <tr class="border-b border-[#1f3627] text-[11px] text-slate-400">
                    <th class="py-1.5">Learning Areas</th>
                    <th class="py-1.5 text-center">Q1</th>
                    <th class="py-1.5 text-center">Q2</th>
                    <th class="py-1.5 text-center">Q3</th>
                    <th class="py-1.5 text-center">Q4</th>
                    <th class="py-1.5 text-center text-emerald-400">Final</th>
                    <th class="py-1.5 text-right">Remarks</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#1f3627]/50 text-[11px] text-slate-300">
                  <tr>
                    <td class="py-1.5 text-white">Filipino</td>
                    <td class="text-center">88</td>
                    <td class="text-center">89</td>
                    <td class="text-center">90</td>
                    <td class="text-center">91</td>
                    <td class="text-center font-bold text-emerald-400">90</td>
                    <td class="text-right text-[#4ade80]">Passed</td>
                  </tr>
                  <tr>
                    <td class="py-1.5 text-white">English</td>
                    <td class="text-center">87</td>
                    <td class="text-center">88</td>
                    <td class="text-center">89</td>
                    <td class="text-center">90</td>
                    <td class="text-center font-bold text-emerald-400">89</td>
                    <td class="text-right text-[#4ade80]">Passed</td>
                  </tr>
                  <tr>
                    <td class="py-1.5 text-white">Mathematics</td>
                    <td class="text-center">91</td>
                    <td class="text-center">92</td>
                    <td class="text-center">92</td>
                    <td class="text-center">93</td>
                    <td class="text-center font-bold text-emerald-400">92</td>
                    <td class="text-right text-[#4ade80]">Passed</td>
                  </tr>
                  <tr>
                    <td class="py-1.5 text-white">Science</td>
                    <td class="text-center">86</td>
                    <td class="text-center">87</td>
                    <td class="text-center">88</td>
