---
// Features component - What TIS RMS does, in plain language
const featuresList = [
  {
    icon: "🔎",
    title: "Student Lookup",
    description: "Search any student by name or their 12-digit LRN. View their basic profile and registered documents instantly.",
  },
  {
    icon: "📝",
    title: "Register from SF-10 & SF-9",
    description: "Use official school forms to quickly add student basic information. The fastest method for historical records (2021 onwards).",
  },
  {
    icon: "📷",
    title: "Scan Paper Documents",
    description: "Point your Android camera at a paper form — the app automatically reads and fills in the student details for you.",
  },
  {
    icon: "📊",
    title: "Export SF-10 to Excel",
    description: "Generate official DepEd School Form 10 spreadsheets pre-filled with student data. Ready to print or submit.",
  },
  {
    icon: "📁",
    title: "Archive Overview & 4Ps",
    description: "View summaries of all registered records, track 4Ps beneficiaries, and prepare audit-ready reports.",
  },
  {
    icon: "📶",
    title: "Works Without Internet",
    description: "Designed for Talisay Integrated School — runs on your local school network so teachers are never blocked by internet issues.",
  },
];
---

<section id="features" class="relative bg-[#09110c] py-24 border-t border-white/5 text-white">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-[#4ade80] uppercase tracking-widest mb-3">Features</p>
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
        Everything you need to manage school records.
      </h2>
      <p class="mt-4 text-base text-slate-400 leading-relaxed">
        Simple tools to help school staff register, organize, and access student information — without the complexity.
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featuresList.map((item) => (
        <div class="rounded-2xl border border-white/8 bg-white/3 p-6 transition hover:bg-white/6 hover:border-white/14">
          <div class="text-3xl mb-4">{item.icon}</div>
          <h3 class="font-display text-lg font-semibold text-white">{item.title}</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
