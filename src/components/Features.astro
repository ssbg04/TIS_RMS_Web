---
// Features component - Student Records Management for Talisay Integrated School
const featuresList = [
  {
    num: "01",
    title: "Student LRN & Basic Profile Directory",
    description: "Manage historical student profiles, look up 12-digit LRNs, and catalog basic learner information from records dated 2021 onwards.",
    tag: "Profile Directory",
  },
  {
    num: "02",
    title: "Basic Info Registration (SF10 & SF9)",
    description: "SF-10 and SF-9 documents provide the most efficient method to add basic student information into the system. Basic registration only—not enrollment.",
    tag: "Efficient Method",
  },
  {
    num: "03",
    title: "Automated OCR Document Scanner",
    description: "Digitize historical paper transcripts and documents (2021+) automatically using local Tesseract OCR, saving hours of manual data entry.",
    tag: "Tesseract OCR",
  },
  {
    num: "04",
    title: "DepEd SF-10 Spreadsheet Export",
    description: "Generate official DepEd School Form 10 (JHS and SHS v2026) spreadsheets with pre-populated student biographical data and historical records.",
    tag: "SF-10 Integration",
  },
  {
    num: "05",
    title: "Archival Records & 4Ps Overview",
    description: "Monitor cataloged historical files from 2021 onwards, classify 4Ps beneficiaries, and export audit-ready summaries for division inspection.",
    tag: "Archival Summary",
  },
  {
    num: "06",
    title: "100% Offline Campus LAN Resilience",
    description: "Designed specifically for Talisay Integrated School — access and update records smoothly on the local network even during internet outages in Tiaong.",
    tag: "Local SQLite DB",
  },
];
---

<section id="features" class="relative bg-[#09110c] py-24 border-t border-[#1f3627] text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#2a4c37] bg-[#112017] px-4 py-1 text-xs font-semibold text-[#4ade80]">
        <img src="/tis_logo.png" alt="TIS Logo" class="h-3.5 w-3.5 object-contain" />
        <span>Core System Modules</span>
      </div>
      <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        Designed for historical records management.
      </h2>
      <p class="mt-4 text-base text-slate-300 sm:text-lg">
        Streamlined tools to digitize, organize, and register student information from old documents (2021 onwards) without grade tracking overhead.
      </p>
    </div>

    <!-- Minimalist Feature Grid -->
    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featuresList.map((item) => (
        <div class="group relative flex flex-col justify-between rounded-2xl border border-[#233e2e] bg-[#112017]/90 p-6 transition hover:border-[#16a34a] hover:bg-[#14261c]">
          
          <div>
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm font-bold text-[#4ade80]">
                {item.num}
              </span>

              <span class="rounded bg-black/30 border border-[#23412f] px-2 py-0.5 text-[10px] font-mono text-amber-400">
                {item.tag}
              </span>
            </div>

            <h3 class="mt-4 font-display text-base font-bold text-white group-hover:text-[#a7f3d0] transition-colors">
              {item.title}
            </h3>

            <p class="mt-2 text-xs leading-relaxed text-slate-300">
              {item.description}
            </p>
          </div>

          <div class="mt-5 border-t border-[#1f3627] pt-3 text-xs font-mono text-[#4ade80]">
            <span>Active Record Module</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
