---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TIS RMS - Student Records, Made Simple | Talisay Integrated School",
  description = "A secure, practical records management system for Talisay Integrated School staff to organize learner records, digitize documents, and find information.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Inline theme script: detect system preference if no saved preference -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("tis-rms-theme");
          if (saved === "dark" || saved === "light") {
            document.documentElement.dataset.theme = saved;
          } else {
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.dataset.theme = prefersDark ? "dark" : "light";
          }
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15803d" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/tis_logo.png" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Preload critical assets -->
    <link rel="preload" href="/tis_logo.png" as="image" />
    <link rel="preload" href="/app_screenshot.png" as="image" />

    <!-- DNS prefetch for external links -->
    <link rel="dns-prefetch" href="https://demo.tis-rms.cc.cd" />
    <link rel="dns-prefetch" href="https://docs.tis-rms.cc.cd" />
    <link rel="dns-prefetch" href="https://api.github.com" />

    <title>{title}</title>
    <link rel="icon" href="/tis_logo.png" type="image/png" />
  </head>

  <body>
    <slot />
  </body>
</html>
