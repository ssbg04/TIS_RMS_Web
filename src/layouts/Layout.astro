---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TIS RMS — Student Records Management System (2021 Onwards) | Talisay Integrated School",
  description = "Records management system for Talisay Integrated School in Tiaong, Quezon. Dedicated to managing and digitizing historical learner records from old documents 2021 onwards using SF10 and SF9 for efficient basic information registration.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15803d" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/tis_logo.png" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <title>{title}</title>

    <link rel="icon" href="/tis_logo.png" type="image/png" />
  </head>

  <body class="bg-[#09110c] text-slate-100 selection:bg-[#16a34a] selection:text-white school-watermark-bg min-h-screen">
    <slot />
  </body>
</html>