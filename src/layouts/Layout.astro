---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TIS_RMS — Record Management System",
  description = "A modern record management system for efficient student records, document processing, reporting, and archival.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <title>{title}</title>

    <link rel="icon" href="/logo.png" />
  </head>

  <body>
    <slot />
  </body>
</html>