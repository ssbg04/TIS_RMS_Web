---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TIS RMS — Student Records, Made Simple | Talisay Integrated School",
  description = "A secure, practical records management system for Talisay Integrated School staff to organize learner records, digitize documents, and find information.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("tis-rms-theme");
          document.documentElement.dataset.theme = savedTheme === "dark" ? "dark" : "light";
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15803d" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/tis_logo.png" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <title>{title}</title>

    <link rel="icon" href="/tis_logo.png" type="image/png" />
  </head>

  <body>
    <slot />
  </body>
</html>